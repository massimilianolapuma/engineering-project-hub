    "typographyMeta": {
      "title-large": {
        "displayName": "Title large (--text-title-size-large)",
        "purpose": "Score in the project header."
      },
      "title-medium": {
        "displayName": "Title medium (--text-title-size-medium)",
        "purpose": "Page title (h1) and the score in a list row."
      },
      "title-small": {
        "displayName": "Title small (--text-title-size-small)",
        "purpose": "Section titles (h2), environment versions."
      },
      "body-large": {
        "displayName": "Body large (--text-body-size-large)",
        "purpose": "Lead sentence, project names, brand name, count values."
      },
      "body": {
        "displayName": "Body (--text-body-size-medium)",
        "purpose": "Lists, tables, forms; running text never below 14px."
      },
      "label": {
        "displayName": "Label (--text-body-size-small)",
        "purpose": "Labels, column heads, confidence, notes, run bar, footer; 12px minimum."
      },
      "mono": {
        "displayName": "Mono (--fontStack-monospace)",
        "purpose": "Code, repository names, SHAs and versions only."
      }
    },
    "shadows": [
      {
        "name": "pressed-ring",
        "value": "inset 0 0 0 1px var(--fgColor-default)",
        "purpose": "Pressed count filter only."
      },
      {
        "name": "overdue-ring",
        "value": "inset 0 0 0 1px currentColor",
        "purpose": "Overdue Label emphasis (not a health state)."
      },
      {
        "name": "invalid-ring",
        "value": "0 0 0 1px var(--fgColor-danger)",
        "purpose": "Invalid catalog field."
      }
    ],
    "motion": [
      {
        "name": "disclosure-turn",
        "value": "transform 0.15s ease",
        "purpose": "Chevron rotation on <details>; removed under prefers-reduced-motion."
      }
    ],
    "breakpoints": [
      {
        "name": "stack",
        "value": "640px"
      },
      {
        "name": "phone",
        "value": "720px"
      }
    ],
    "themes": {
      "mechanism": "<html data-color-mode=\"auto|light|dark\" data-light-theme=\"light\" data-dark-theme=\"dark\">",
      "storageKey": "eph-theme",
      "restoreScript": "public/theme-init.js",
      "source": "@primer/primitives 11.10.0"
    },
    "icons": {
      "library": "@primer/octicons",
      "brandMark": "stack",
      "health": {
        "green": "check-circle-fill",
        "amber": "alert-fill",
        "red": "x-circle-fill",
        "grey": "question",
        "info": "clock",
        "muted": "dash"
      },
      "controlSymbols": {
        "ok": "check-circle",
        "gap": "alert",
        "stale": "clock",
        "blind": "question",
        "na": "dash",
        "failed": "x-circle"
      },
      "nav": {
        "portfolio": "apps",
        "changes": "history",
        "security": "shield",
        "versions": "tag",
        "workflows": "workflow",
        "dataQuality": "database",
        "catalog": "book",
        "howToRead": "question"
      }
    },
    "hubTokens": {
      "--status-col": "112px"
    }
  },
  "components": [
    {
      "name": "Header band with UnderlineNav",
      "kind": "nav",
      "refersTo": "header-band",
      "description": "One muted band: brand row, then icon + label tabs; current tab semibold with a 2px coral underline.",
      "html": "<header class=\"ds-band\"><div class=\"ds-brand\"><svg version=\"1.1\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" class=\"octicon octicon-stack\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M11.063 1.456a1.749 1.749 0 0 1 1.874 0l8.383 5.316a1.751 1.751 0 0 1 0 2.956l-8.383 5.316a1.749 1.749 0 0 1-1.874 0L2.68 9.728a1.751 1.751 0 0 1 0-2.956Zm1.071 1.267a.25.25 0 0 0-.268 0L3.483 8.039a.25.25 0 0 0 0 .422l8.383 5.316a.25.25 0 0 0 .268 0l8.383-5.316a.25.25 0 0 0 0-.422Z\"></path><path d=\"M1.867 12.324a.75.75 0 0 1 1.035-.232l8.964 5.685a.25.25 0 0 0 .268 0l8.964-5.685a.75.75 0 0 1 .804 1.267l-8.965 5.685a1.749 1.749 0 0 1-1.874 0l-8.965-5.685a.75.75 0 0 1-.231-1.035Z\"></path><path d=\"M1.867 16.324a.75.75 0 0 1 1.035-.232l8.964 5.685a.25.25 0 0 0 .268 0l8.964-5.685a.75.75 0 0 1 .804 1.267l-8.965 5.685a1.749 1.749 0 0 1-1.874 0l-8.965-5.685a.75.75 0 0 1-.231-1.035Z\"></path></svg>Engineering Project Hub</div><nav><a class=\"ds-tab\" aria-current=\"page\" href=\"#\">Portfolio</a><a class=\"ds-tab\" href=\"#\">Security</a><a class=\"ds-tab\" href=\"#\">Versions</a></nav></header>",
      "css": ".ds-band{background:var(--bgColor-muted);border-bottom:1px solid var(--borderColor-default);padding:12px 24px 0;font-family:var(--fontStack-system);color:var(--fgColor-default)}.ds-brand{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:600;min-height:40px}.ds-brand svg{color:var(--fgColor-default)}.ds-band nav{display:flex;gap:8px}.ds-tab{position:relative;display:flex;align-items:center;min-height:48px;padding:0 8px;color:var(--fgColor-default);font-size:14px;text-decoration:none;border-radius:6px}.ds-tab:hover{background:var(--bgColor-neutral-muted)}.ds-tab:focus-visible{outline:2px solid var(--fgColor-accent);outline-offset:-2px}.ds-tab[aria-current=page]{font-weight:600}.ds-tab[aria-current=page]::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:2px;border-radius:6px;background:var(--underlineNav-borderColor-active)}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Every button except the one GitHub action.",
      "html": "<button class=\"ds-btn\">Add repository</button>",
      "css": ".ds-btn{font:inherit;font-family:var(--fontStack-system);font-size:14px;font-weight:500;min-height:40px;padding:6px 16px;color:var(--button-default-fgColor-rest);background:var(--button-default-bgColor-rest);border:1px solid var(--button-default-borderColor-rest);border-radius:6px;cursor:pointer}.ds-btn:hover{background:var(--button-default-bgColor-hover);border-color:var(--button-default-borderColor-hover)}.ds-btn:focus-visible{outline:2px solid var(--fgColor-accent);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Green, GitHub style; only the action that opens GitHub to propose or edit a catalog file.",
      "html": "<button class=\"ds-btn-primary\">Propose on GitHub</button>",
      "css": ".ds-btn-primary{font:inherit;font-family:var(--fontStack-system);font-size:14px;font-weight:500;min-height:44px;padding:6px 18px;color:var(--button-primary-fgColor-rest);background:var(--button-primary-bgColor-rest);border:1px solid var(--button-primary-borderColor-rest);border-radius:6px;cursor:pointer}.ds-btn-primary:hover{background:var(--button-primary-bgColor-hover);border-color:var(--button-primary-borderColor-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--fgColor-accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Primer FormControl look: label above, 40px field.",
      "html": "<label class=\"ds-field\"><span>Search</span><input class=\"ds-input\" placeholder=\"Project or repository\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:var(--fontStack-system);font-size:12px;font-weight:600;color:var(--fgColor-default)}.ds-input{font:inherit;font-size:14px;font-weight:400;height:40px;padding:0 12px;color:var(--fgColor-default);background:var(--control-bgColor-rest);border:1px solid var(--control-borderColor-rest);border-radius:6px}.ds-input:hover{background:var(--control-bgColor-hover)}.ds-input:focus-visible{outline:2px solid var(--fgColor-accent);outline-offset:2px}.ds-input::placeholder{color:var(--fgColor-muted)}"
    },
    {
      "name": "Status Labels",
      "kind": "chip",
      "refersTo": "label-danger",
      "description": "Primer Label per state with its Octicon; unknown is a dashed outline, never a fill.",
      "html": "<span class=\"ds-label ds-danger\"><svg version=\"1.1\" width=\"14\" height=\"14\" viewBox=\"0 0 12 12\" class=\"octicon octicon-x-circle-fill\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M1.757 10.243a6.001 6.001 0 1 1 8.488-8.486 6.001 6.001 0 0 1-8.488 8.486ZM6 4.763l-2-2L2.763 4l2 2-2 2L4 9.237l2-2 2 2L9.237 8l-2-2 2-2L8 2.763Z\"></path></svg>Critical</span> <span class=\"ds-label ds-attention\"><svg version=\"1.1\" width=\"14\" height=\"14\" viewBox=\"0 0 12 12\" class=\"octicon octicon-alert-fill\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M4.855.708c.5-.896 1.79-.896 2.29 0l4.675 8.351a1.312 1.312 0 0 1-1.146 1.954H1.33A1.313 1.313 0 0 1 .183 9.058ZM7 7V3H5v4Zm-1 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z\"></path></svg>Attention</span> <span class=\"ds-label ds-success\"><svg version=\"1.1\" width=\"14\" height=\"14\" viewBox=\"0 0 12 12\" class=\"octicon octicon-check-circle-fill\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M6 0a6 6 0 1 1 0 12A6 6 0 0 1 6 0Zm-.705 8.737L9.63 4.403 8.392 3.166 5.295 6.263l-1.7-1.702L2.356 5.8l2.938 2.938Z\"></path></svg>Healthy</span> <span class=\"ds-label ds-unknown\"><svg version=\"1.1\" width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" class=\"octicon octicon-question\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.92 6.085h.001a.749.749 0 1 1-1.342-.67c.169-.339.436-.701.849-.977C6.845 4.16 7.369 4 8 4a2.756 2.756 0 0 1 1.637.525c.503.377.863.965.863 1.725 0 .448-.115.83-.329 1.15-.205.307-.47.513-.692.662-.109.072-.22.138-.313.195l-.006.004a6.24 6.24 0 0 0-.26.16.952.952 0 0 0-.276.245.75.75 0 0 1-1.248-.832c.184-.264.42-.489.692-.661.103-.067.207-.132.313-.195l.007-.004c.1-.061.182-.11.258-.161a.969.969 0 0 0 .277-.245C8.96 6.514 9 6.427 9 6.25a.612.612 0 0 0-.262-.525A1.27 1.27 0 0 0 8 5.5c-.369 0-.595.09-.74.187a1.01 1.01 0 0 0-.34.398ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z\"></path></svg>Unknown</span> <span class=\"ds-label ds-severe\">High</span>",
      "css": ".ds-label{display:inline-flex;align-items:center;gap:4px;min-height:20px;line-height:18px;padding:0 7px;border:1px solid var(--borderColor-default);border-radius:9999px;font-family:var(--fontStack-system);font-size:12px;font-weight:500;white-space:nowrap}.ds-danger{background:var(--bgColor-danger-muted);color:var(--fgColor-danger);border-color:var(--borderColor-danger-muted)}.ds-attention{background:var(--bgColor-attention-muted);color:var(--fgColor-attention);border-color:var(--borderColor-attention-muted)}.ds-success{background:var(--bgColor-success-muted);color:var(--fgColor-success);border-color:var(--borderColor-success-muted)}.ds-severe{background:var(--bgColor-severe-muted);color:var(--fgColor-severe);border-color:var(--borderColor-severe-muted)}.ds-unknown{background:transparent;color:var(--fgColor-muted);border:1.5px dashed var(--borderColor-emphasis)}"
    },
    {
      "name": "Box with list rows",
      "kind": "card",
      "refersTo": "box",
      "description": "Primer Box: muted header row, rows split by borders, muted hover.",
      "html": "<div class=\"ds-box\"><div class=\"ds-box-head\">Project</div><div class=\"ds-row\">payments-platform</div><div class=\"ds-row\">identity-service</div></div>",
      "css": ".ds-box{background:var(--bgColor-default);border:1px solid var(--borderColor-default);border-radius:6px;overflow:hidden;font-family:var(--fontStack-system);font-size:14px;color:var(--fgColor-default)}.ds-box-head{padding:10px 16px;background:var(--bgColor-muted);border-bottom:1px solid var(--borderColor-default);font-size:12px;font-weight:600;color:var(--fgColor-muted)}.ds-row{padding:14px 16px;border-bottom:1px solid var(--borderColor-default)}.ds-row:last-child{border-bottom:0}.ds-row:hover{background:var(--bgColor-muted)}"
    },
    {
      "name": "Dimension bars",
      "kind": "custom",
      "refersTo": "dimension-bar",
      "description": "Six 32px bars; height repeats state (critical 20, attention 13, healthy 7); unknown dashed at full height.",
      "html": "<span class=\"ds-bars\"><i class=\"ds-b ds-red\"></i><i class=\"ds-b ds-amber\"></i><i class=\"ds-b ds-green\"></i><i class=\"ds-b ds-grey\"></i><i class=\"ds-b ds-green\"></i><i class=\"ds-b ds-amber\"></i></span>",
      "css": ".ds-bars{display:inline-flex;gap:4px;align-items:flex-end;height:20px}.ds-b{display:block;width:32px;border-radius:2px}.ds-red{height:20px;background:var(--fgColor-danger)}.ds-amber{height:13px;background:var(--fgColor-attention)}.ds-green{height:7px;background:var(--fgColor-success)}.ds-grey{height:20px;box-sizing:border-box;border:1.5px dashed var(--borderColor-emphasis)}"
    },
    {
      "name": "Control symbols",
      "kind": "custom",
      "refersTo": "control-symbol",
      "description": "24px chips holding the SYMBOL_ICON Octicon; blind is dashed, na has no fill.",
      "html": "<span class=\"ds-sym ds-ok\" role=\"img\" aria-label=\"Enabled\"><svg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon octicon-check-circle\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm1.5 0a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Zm10.28-1.72-4.5 4.5a.75.75 0 0 1-1.06 0l-2-2a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018l1.47 1.47 3.97-3.97a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042Z\"></path></svg></span> <span class=\"ds-sym ds-blind\" role=\"img\" aria-label=\"Not visible\"><svg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon octicon-question\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.92 6.085h.001a.749.749 0 1 1-1.342-.67c.169-.339.436-.701.849-.977C6.845 4.16 7.369 4 8 4a2.756 2.756 0 0 1 1.637.525c.503.377.863.965.863 1.725 0 .448-.115.83-.329 1.15-.205.307-.47.513-.692.662-.109.072-.22.138-.313.195l-.006.004a6.24 6.24 0 0 0-.26.16.952.952 0 0 0-.276.245.75.75 0 0 1-1.248-.832c.184-.264.42-.489.692-.661.103-.067.207-.132.313-.195l.007-.004c.1-.061.182-.11.258-.161a.969.969 0 0 0 .277-.245C8.96 6.514 9 6.427 9 6.25a.612.612 0 0 0-.262-.525A1.27 1.27 0 0 0 8 5.5c-.369 0-.595.09-.74.187a1.01 1.01 0 0 0-.34.398ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z\"></path></svg></span> <span class=\"ds-sym ds-na\" role=\"img\" aria-label=\"Not applicable\"><svg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon octicon-dash\" aria-hidden=\"true\" data-component=\"Octicon\" fill=\"currentColor\"><path d=\"M2 7.75A.75.75 0 0 1 2.75 7h10a.75.75 0 0 1 0 1.5h-10A.75.75 0 0 1 2 7.75Z\"></path></svg></span>",
      "css": ".ds-sym{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;box-sizing:border-box;border-radius:3px}.ds-ok{background:var(--bgColor-success-muted);color:var(--fgColor-success)}.ds-blind{color:var(--fgColor-muted);border:1.5px dashed var(--borderColor-emphasis)}.ds-na{color:var(--fgColor-muted)}"
    }
  ],
  "narrative": {
    "northStar": "A natural extension of GitHub: legibility first",
    "overview": "The hub is a reading instrument for a weekly portfolio review, dressed in GitHub Primer (`@primer/primitives` 11.10.0, `@primer/octicons`) so it feels like one more tab of a GitHub organisation. Each page says one thing first (a single sentence such as \"3 of 4 projects need attention\"), then shows the list sorted worst first, and keeps the detail one click away. Character comes from Primer's restraint: white or near-black page, hairline Box borders, one muted header band, Labels for state, Octicons for every symbol, and status colour only where a status is.\n\nStatus is a small, exact mark rather than a painted area: a 10px dot, six 32px dimension bars whose height repeats the state, a Primer Label with an Octicon, a 24px control symbol. Primer's `success`, `attention`, `severe` and `danger` families colour those marks. Unknown is never a fill and never calm: no fill, a 1.5px dashed `--borderColor-emphasis` outline and `--fgColor-muted` text, with the cause named in words, never shown as zero. A project score (0–100) sits next to the status with its confidence (\"measured 4 of 6\") always visible; with insufficient data there is an em dash, never a 0.\n\nComponents use Primer functional tokens directly (`--fgColor-*`, `--bgColor-*`, `--borderColor-*`, `--button-*`, `--base-size-*`, `--borderRadius-*`, `--text-*`, `--fontStack-*`); `src/styles/tokens.css` only imports them and adds one hub token, `--status-col`. Shared base styles live in `src/styles/global.css`, page styles in each page's scoped `<style>`. The hub's earlier \"Warm Graphite\" system was retired in v0.10.0.",
    "keyCharacteristics": [
      "One dominant sentence per page, then the list worst first, detail on demand.",
      "Primer functional tokens only; light and dark through Primer colour modes.",
      "Status as small exact marks (dot, dimension bars, Label, control symbol), always with an Octicon, a word or an accessible name.",
      "Unknown is a dashed outline with the cause in words: never a fill, never zero, never calmer than a gap.",
      "System font stack, no web fonts; monospace only for code, repositories, SHAs and versions.",
      "Flat Boxes with 1px borders and 6px corners; Labels fully rounded.",
      "Looks like GitHub, never claims to be GitHub."
    ],
    "rules": [
      {
        "name": "The Accent Is Not Status Rule",
        "body": "Blue is for links, focus and invisible buttons; coral only underlines the current tab; green fills only the primary button outside status marks. None of them ever marks a health state, a severity or a count.",
        "section": "colors"
      },
      {
        "name": "The Dashed Unknown Rule",
        "body": "Unknown, not authorised and collection failed are drawn with no fill, a 1.5px dashed `--borderColor-emphasis` outline and `--fgColor-muted` text, and the cause is named. They are never filled, never green, never shown as 0, and never visually calmer than an optional gap. The 10px status dot is the one exception: a hollow 2px solid ring, because a dashed 10px circle reads as a loading spinner.",
        "section": "colors"
      },
      {
        "name": "The Tested Pair Rule",
        "body": "Primer's own colours are used without substitutions. `tests/unit/tokens-contrast.test.ts` reads the pinned theme files in both themes, composites translucent tints, and asserts 4.5:1 for default, muted and accent text on the page and muted surfaces, for each status `fgColor` on its own muted tint, and for the primary button text; and 3:1 for the danger, attention, success marks and the emphasis border. A new text/background pair is added to that test before it ships.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Scores, counts, table cells, versions and relative times use `tabular-nums`. A partial count is marked as incomplete; an unknown count is a dash with accessible text, never 0.",
        "section": "typography"
      },
      {
        "name": "The Status Column Rule",
        "body": "A Label placed before text sits in a fixed 112px column (`--status-col`, the only hub token) so the text after it starts at the same x on every row.",
        "section": "layout"
      },
      {
        "name": "The Flat Box Rule",
        "body": "Nothing floats. The only rings are insets that mark state: the pressed count filter (`inset 0 0 0 1px` in `--fgColor-default`), the Overdue Label (`inset 0 0 0 1px currentColor`) and an invalid catalog field (`0 0 0 1px` in `--fgColor-danger`).",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use Primer functional tokens directly; add a hub token only when Primer has no equivalent (today only `--status-col`).",
      "**Do** start each page with one sentence, then the list sorted worst first; put detail in `<details>` or on the project page.",
      "**Do** pair every status mark with an Octicon and a word or an accessible name; use `SYMBOL_ICON` with the same meaning everywhere.",
      "**Do** draw unknown with no fill, a 1.5px dashed `--borderColor-emphasis` outline and `--fgColor-muted` text, and name the cause.",
      "**Do** write severity as a word: critical `danger`, high `severe`, medium `attention`, low neutral.",
      "**Do** keep Labels before text in the 112px status column.",
      "**Do** keep touch targets at least 40px, and 44px for the primary button.",
      "**Do** add every new text/background pair to `tests/unit/tokens-contrast.test.ts` in both themes.",
      "**Do** keep the footer line \"Not affiliated with GitHub · built with Primer\"."
    ],
    "donts": [
      "**Don't** pass as GitHub: no Octocat or `mark-github`, no \"GitHub\" as the product name, no \"official\".",
      "**Don't** render unknown, not authorised, collection failed or partial counts as 0, as a fill, or in green.",
      "**Don't** use the accent blue, the primary green or the UnderlineNav coral for status, or status colours for links.",
      "**Don't** draw severity with health shapes or call it a health state.",
      "**Don't** load web fonts, override Primer colours with hand-picked hex values, or set a literal font size.",
      "**Don't** add drop shadows, gradients, side-stripe borders or glassmorphism.",
      "**Don't** let colour be the only carrier of status.",
      "**Don't** set running text below 14px or any label below 12px."
    ]
  }
}
