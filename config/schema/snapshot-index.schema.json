{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "run": {
      "type": "object",
      "properties": {
        "dataSource": {
          "type": "string",
          "enum": [
            "mock",
            "github"
          ]
        },
        "authenticationMode": {
          "type": "string",
          "enum": [
            "github-app",
            "fine-grained-token",
            "github-token",
            "mock"
          ]
        },
        "collectorVersion": {
          "type": "string",
          "maxLength": 50
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capabilities": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "metadata",
              "contents",
              "actions",
              "codeScanning",
              "dependabot",
              "secretScanning"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "available",
              "partial",
              "not-authorised",
              "unknown",
              "not-used"
            ]
          },
          "required": [
            "metadata",
            "contents",
            "actions",
            "codeScanning",
            "dependabot",
            "secretScanning"
          ]
        },
        "inaccessibleSources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "maxLength": 200
              },
              "source": {
                "type": "string",
                "enum": [
                  "repository",
                  "branch",
                  "release",
                  "tag",
                  "manifest",
                  "gitmodules",
                  "submodule",
                  "workflow-runs",
                  "code-scanning",
                  "dependabot",
                  "secret-scanning",
                  "security-status-file"
                ]
              },
              "classification": {
                "type": "string",
                "enum": [
                  "not-found",
                  "not-authorised",
                  "not-configured",
                  "rate-limited",
                  "invalid-data",
                  "error"
                ]
              }
            },
            "required": [
              "repository",
              "source",
              "classification"
            ],
            "additionalProperties": false
          }
        },
        "repositories": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ok": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "withErrors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unavailable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "ok",
            "withErrors",
            "unavailable"
          ],
          "additionalProperties": false
        },
        "configValid": {
          "type": "boolean"
        },
        "policy": {
          "type": "object",
          "properties": {
            "snapshotStaleHours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "audience": {
              "type": "string",
              "enum": [
                "public",
                "restricted"
              ]
            }
          },
          "required": [
            "snapshotStaleHours",
            "audience"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "dataSource",
        "authenticationMode",
        "collectorVersion",
        "startedAt",
        "finishedAt",
        "durationMs",
        "capabilities",
        "inaccessibleSources",
        "repositories",
        "configValid",
        "policy"
      ],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "businessUnit": {
            "type": "string",
            "maxLength": 100
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "experimental",
              "development",
              "production",
              "maintenance",
              "deprecated"
            ]
          },
          "overall": {
            "type": "string",
            "enum": [
              "green",
              "amber",
              "red",
              "grey"
            ]
          },
          "delivery": {
            "type": "string",
            "enum": [
              "green",
              "amber",
              "red",
              "grey"
            ]
          },
          "version": {
            "type": "string",
            "enum": [
              "green",
              "amber",
              "red",
              "grey"
            ]
          },
          "security": {
            "type": "string",
            "enum": [
              "green",
              "amber",
              "red",
              "grey"
            ]
          },
          "coverage": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "green",
                  "amber",
                  "red",
                  "grey"
                ]
              },
              "percentage": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "required": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "available": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "status",
              "percentage",
              "required",
              "available"
            ],
            "additionalProperties": false
          },
          "governance": {
            "type": "string",
            "enum": [
              "green",
              "amber",
              "red",
              "grey"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "green",
              "amber",
              "red",
              "grey"
            ]
          },
          "openCounts": {
            "type": "object",
            "properties": {
              "critical": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "high": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "medium": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "low": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "informational": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unknown": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "critical",
              "high",
              "medium",
              "low",
              "informational",
              "unknown"
            ],
            "additionalProperties": false
          },
          "countsComplete": {
            "type": "boolean"
          },
          "openSecretAlerts": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "secretScanning": {
            "type": "string",
            "enum": [
              "enabled",
              "not-configured",
              "configured-not-run",
              "not-authorised",
              "failed",
              "stale",
              "unknown",
              "collection-failed",
              "not-applicable"
            ]
          },
          "failedCriticalWorkflows": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "collectionErrorCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unresolvedSubmodules": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "businessUnit",
          "lifecycle",
          "overall",
          "delivery",
          "version",
          "security",
          "coverage",
          "governance",
          "freshness",
          "openCounts",
          "countsComplete",
          "openSecretAlerts",
          "secretScanning",
          "failedCriticalWorkflows",
          "collectedAt",
          "collectionErrorCount",
          "unresolvedSubmodules"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "run",
    "projects"
  ],
  "additionalProperties": false
}
