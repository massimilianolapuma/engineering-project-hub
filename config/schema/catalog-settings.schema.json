{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "discovery": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "owners": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
          }
        },
        "includePrivate": {
          "default": false,
          "type": "boolean"
        },
        "includeForks": {
          "default": false,
          "type": "boolean"
        },
        "includeArchived": {
          "default": false,
          "type": "boolean"
        },
        "maxRepositories": {
          "default": 200,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "topics": {
          "default": false,
          "type": "boolean"
        },
        "customProperties": {
          "default": false,
          "type": "boolean"
        },
        "hints": {
          "default": {},
          "type": "object",
          "properties": {
            "projectProperty": {
              "default": "hub-project",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"
            },
            "componentProperty": {
              "default": "hub-component",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"
            },
            "typeProperty": {
              "default": "hub-component-type",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"
            },
            "projectTopicPrefix": {
              "default": "project-",
              "type": "string",
              "pattern": "^[a-z0-9-]{1,30}$"
            },
            "typeTopicPrefix": {
              "default": "type-",
              "type": "string",
              "pattern": "^[a-z0-9-]{1,30}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "teams": {
      "type": "object",
      "properties": {
        "discovery": {
          "default": false,
          "type": "boolean"
        },
        "naming": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string"
            },
            "roles": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
              }
            },
            "lines": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          },
          "required": [
            "pattern",
            "roles",
            "lines"
          ],
          "additionalProperties": false
        },
        "maxTeams": {
          "default": 300,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
