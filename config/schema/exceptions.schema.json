{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "exceptions": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,39}$"
          },
          "repository": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9-]+\\/[A-Za-z0-9._-]+$"
          },
          "source": {
            "type": "string",
            "enum": [
              "code-scanning",
              "dependabot",
              "secret-scanning"
            ]
          },
          "match": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "alert": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "alert"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                },
                "required": [
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "advisory": {
                    "type": "string",
                    "pattern": "^(GHSA(-[A-Za-z0-9]{4}){3}|CVE-\\d{4}-\\d{4,})$"
                  }
                },
                "required": [
                  "advisory"
                ],
                "additionalProperties": false
              }
            ]
          },
          "owner": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "ticket": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "created": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "repository",
          "source",
          "match",
          "owner",
          "reason",
          "created",
          "expires"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "exceptions"
  ],
  "additionalProperties": false
}
