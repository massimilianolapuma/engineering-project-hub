{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "sbom": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "cyclonedx",
            "spdx"
          ]
        },
        "specVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "packages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "withoutLicense": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "licenses": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "ecosystems": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "npm",
                  "maven",
                  "pypi",
                  "nuget",
                  "golang",
                  "cargo",
                  "gem",
                  "composer",
                  "githubactions",
                  "docker",
                  "pub",
                  "swift",
                  "hex",
                  "other",
                  "unknown"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "specVersion",
        "tool",
        "packages",
        "withoutLicense",
        "licenses",
        "ecosystems"
      ],
      "additionalProperties": false
    },
    "images": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "signature": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not-verified",
                  "failed",
                  "missing"
                ]
              },
              "tool": {
                "type": "string",
                "enum": [
                  "cosign",
                  "notation",
                  "gh-attestation",
                  "other"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not-verified",
                  "failed",
                  "missing"
                ]
              },
              "tool": {
                "type": "string",
                "enum": [
                  "cosign",
                  "notation",
                  "gh-attestation",
                  "other"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          "sbomAttestation": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not-verified",
                  "failed",
                  "missing"
                ]
              },
              "tool": {
                "type": "string",
                "enum": [
                  "cosign",
                  "notation",
                  "gh-attestation",
                  "other"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "ref",
    "commitSha",
    "generatedAt"
  ],
  "additionalProperties": false
}
