{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "sources": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "azure-devops"
          },
          "organization": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,49}$"
          },
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "environments": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ado": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                },
                "github": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "production": {
                  "default": false,
                  "type": "boolean"
                },
                "versionFrom": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    "key": {
                      "type": "string",
                      "maxLength": 100,
                      "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$"
                    }
                  },
                  "required": [
                    "file",
                    "key"
                  ],
                  "additionalProperties": false
                },
                "commitFrom": {
                  "default": "self",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "ado",
                "repository",
                "github"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "organization",
          "project",
          "environments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sources"
  ],
  "additionalProperties": false
}
