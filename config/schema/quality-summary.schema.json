{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "format": {
      "type": "string",
      "enum": [
        "cobertura",
        "lcov",
        "opencover",
        "jacoco",
        "other"
      ]
    },
    "lines": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "valid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "covered",
        "valid"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "ref",
    "commitSha",
    "generatedAt",
    "tool",
    "format",
    "lines"
  ],
  "additionalProperties": false
}
