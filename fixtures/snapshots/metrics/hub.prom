# HELP hub_info Engineering Project Hub collection metadata; always 1.
# TYPE hub_info gauge
hub_info{collector_version="0.14.1",data_source="mock",schema_version="1.8"} 1
# HELP hub_collection_timestamp_seconds When the data was collected, as Unix seconds.
# TYPE hub_collection_timestamp_seconds gauge
hub_collection_timestamp_seconds 1768478400
# HELP hub_collection_duration_seconds Duration of the last collection in seconds.
# TYPE hub_collection_duration_seconds gauge
hub_collection_duration_seconds 0
# HELP hub_projects Number of projects in the catalog.
# TYPE hub_projects gauge
hub_projects 4
# HELP hub_portfolio_projects Projects per overall status (grey = not visible, a state, not a zero).
