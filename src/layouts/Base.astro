---
import type { PortfolioIndex } from '@model/index';
import Legend from '../components/Legend.astro';
import RelTime from '../components/RelTime.astro';
import { LOCALES, type I18n, type Locale } from '../i18n';
import { href, type PageKey } from '../lib/routes';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  i18n: I18n;
  title: string;
  page: PageKey | null;
  /** Path of this page in every locale, for the language switcher and hreflang. */
  alternates: Record<Locale, string>;
  index: PortfolioIndex | null;
}
const { i18n, title, page, alternates, index } = Astro.props;
const { d, locale } = i18n;
const nav: PageKey[] = ['portfolio', 'workflows', 'versions', 'security', 'dataQuality', 'catalog'];
const run = index?.run;
const staleHours = run?.policy.snapshotStaleHours ?? 24;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    />
    <title>{`${title} · ${d.meta.appName}`}</title>
    <meta name="description" content={d.meta.tagline} />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`}
      type="image/svg+xml"
    />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={alternates[l]} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {d.nav.skip}
    </a>
    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href={href(locale, 'portfolio')}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              d="M3 7l9-4 9 4-9 4zM3 12l9 4 9-4M3 17l9 4 9-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"
            />
          </svg>
          <span>{d.meta.appName}</span>
        </a>
        <nav class="mainnav" aria-label={d.nav.main}>
          <ul>
            {nav.map((k) => (
              <li>
                <a href={href(locale, k)} aria-current={page === k ? 'page' : undefined}>
                  {d.nav[k]}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="topbar__tools">
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            data-label-theme={d.nav.theme}
            data-label-auto={d.nav.themeAuto}
            data-label-light={d.nav.themeLight}
            data-label-dark={d.nav.themeDark}
          >
            {d.nav.themeAuto}
          </button>
          <nav class="langswitch" aria-label={d.nav.language}>
            {LOCALES.map((l) => (
              <a
                href={alternates[l]}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'true' : undefined}
              >
                {l.toUpperCase()}
                <span class="visually-hidden"> — {l === 'it' ? 'Italiano' : 'English'}</span>
              </a>
            ))}
          </nav>
        </div>
      </div>
      {run && (
        <div class="runbar">
          <div class="runbar__inner">
            <span class={`source source--${run.dataSource}`}>
              {run.dataSource === 'mock' ? d.common.sourceMock : d.common.sourceGithub}
            </span>
            <span>
              {d.common.lastRun}:{' '}
              <RelTime iso={index.generatedAt} i18n={i18n} staleHours={staleHours} />
            </span>
            <span class="muted">
              {d.common.auth}: {d.authMode[run.authenticationMode]}
            </span>
          </div>
        </div>
      )}
      {run && (
        <div
          class="stale-banner"
          role="status"
          hidden
          data-stale-banner
          data-generated={index.generatedAt}
          data-stale-hours={staleHours}
        >
          {i18n.f(d.common.staleBanner, { hours: staleHours })}
        </div>
      )}
      <Legend i18n={i18n} />
    </header>
    <div class="layout">
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="footer">
      <p>
        {d.meta.appName} · {d.meta.tagline}
      </p>
    </footer>
    <script>
      import '../scripts/relative-time';
      import '../scripts/theme-toggle';
    </script>
  </body>
</html>
