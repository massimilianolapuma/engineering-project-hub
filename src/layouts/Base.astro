---
import type { PortfolioIndex } from '@model/index';
import Legend from '../components/Legend.astro';
import Octicon from '../components/Octicon.astro';
import RelTime from '../components/RelTime.astro';
import { LOCALES, type I18n, type Locale } from '../i18n';
import { NAV, NAV_ICON, href, type PageKey } from '../lib/routes';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  i18n: I18n;
  title: string;
  page: PageKey | null;
  /** Path of this page in every locale, for the language switcher and hreflang. */
  alternates: Record<Locale, string>;
  index: PortfolioIndex | null;
  /**
   * Optional one-line legend appended at the end of the main content. Off by default: each
   * page places its own `<Legend>` under its list (the full explanation is "How to read").
   */
  legend?: 'status' | 'symbols' | false;
}
const { i18n, title, page, alternates, index, legend = false } = Astro.props;
const { d, locale } = i18n;
const run = index?.run;
const staleHours = run?.policy.snapshotStaleHours ?? 24;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
/** Signed-in user from Cloudflare Access: opt-in at build time, never on GitHub Pages. */
const identity = import.meta.env.PUBLIC_IDENTITY_SOURCE === 'cloudflare-access';
---

<!doctype html>
<html lang={locale} data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <!-- frame-ancestors is ignored in a <meta> CSP: it is sent as a header (public/_headers). -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
    />
    <!-- Restores the saved theme before first paint (blocking, external: CSP script-src 'self'). -->
    <script is:inline src={`${base}theme-init.js`}></script>
    <title>{`${title} · ${d.meta.appName}`}</title>
    <meta name="description" content={d.meta.tagline} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={alternates[l]} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {d.nav.skip}
    </a>
    <header class="topbar">
      <div class="topbar__inner">
        <a class="brand" href={href(locale, 'portfolio')}>
          <Octicon name="stack" size={24} />
          <span>{d.meta.appName}</span>
        </a>
        <div class="topbar__tools">
          <a
            class="utility-link"
            href={href(locale, 'howToRead')}
            aria-current={page === 'howToRead' ? 'page' : undefined}
          >
            <Octicon name="question" />
            <span class="utility-link__label">{d.nav.howToRead}</span>
          </a>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            data-label-theme={d.nav.theme}
            data-label-auto={d.nav.themeAuto}
            data-label-light={d.nav.themeLight}
            data-label-dark={d.nav.themeDark}
          >
            <Octicon name="device-desktop" class="theme-toggle__icon theme-toggle__icon--auto" />
            <Octicon name="sun" class="theme-toggle__icon theme-toggle__icon--light" />
            <Octicon name="moon" class="theme-toggle__icon theme-toggle__icon--dark" />
            <span data-theme-label>{d.nav.themeAuto}</span>
          </button>
          <nav class="langswitch" aria-label={d.nav.language}>
            {LOCALES.map((l) => (
              <a
                href={alternates[l]}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'true' : undefined}
              >
                {l.toUpperCase()}
                <span class="visually-hidden"> — {l === 'it' ? 'Italiano' : 'English'}</span>
              </a>
            ))}
          </nav>
          {identity && <span class="identity" data-identity data-label={d.nav.signedInAs} hidden />}
        </div>
      </div>
      <nav class="mainnav" aria-label={d.nav.main}>
        <ul>
          {NAV.map((k) => (
            <li>
              <a href={href(locale, k)} aria-current={page === k ? 'page' : undefined}>
                <Octicon name={NAV_ICON[k]} />
                <span>{d.nav[k]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {run && (
        <div class="runbar">
          <div class="runbar__inner">
            <span class={`source source--${run.dataSource}`}>
              {run.dataSource === 'mock' ? d.common.sourceMock : d.common.sourceGithub}
            </span>
            <span>
              {d.common.lastRun}:{' '}
              <RelTime iso={index.generatedAt} i18n={i18n} staleHours={staleHours} />
            </span>
            <span class="muted">
              {d.common.auth}: {d.authMode[run.authenticationMode]}
            </span>
          </div>
        </div>
      )}
      {run && (
        <div
          class="stale-banner"
          role="status"
          hidden
          data-stale-banner
          data-generated={index.generatedAt}
          data-stale-hours={staleHours}
        >
          <Octicon name="alert" />
          <span>{i18n.f(d.common.staleBanner, { hours: staleHours })}</span>
        </div>
      )}
    </header>
    <div class="layout">
      <main id="main" tabindex="-1">
        <slot />
        {legend && <Legend i18n={i18n} kind={legend} />}
      </main>
    </div>
    <footer class="footer">
      <p>
        {d.meta.appName} · {d.meta.tagline}
      </p>
      <p>{d.footer.notAffiliated}</p>
    </footer>
    <script>
      import '../scripts/relative-time';
      import '../scripts/theme-toggle';
      import '../scripts/main-nav';
    </script>
    {identity && <script>
      import '../scripts/identity';
    </script>}
  </body>
</html>
