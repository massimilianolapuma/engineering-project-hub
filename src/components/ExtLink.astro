---
/** Link to the original GitHub resource; GitHub applies its own authorisation. */
import type { I18n } from '../i18n';
interface Props {
  href: string | null | undefined;
  i18n: I18n;
  label?: string;
  class?: string;
}
const { href, i18n, label, class: className } = Astro.props;
---

{href ? (
  <a class:list={['extlink', className]} href={href} rel="noopener noreferrer external">
    <slot>{label ?? i18n.d.common.openInGitHub}</slot>
    <span aria-hidden="true" class="extlink__arrow">
      ↗
    </span>
    <span class="visually-hidden"> {i18n.d.common.opensNewTab}</span>
  </a>
) : (
  <span class="muted">
    <slot>{label ?? i18n.d.common.unknown}</slot>
  </span>
)}
