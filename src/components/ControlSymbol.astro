---
/**
 * Control symbol (an Octicon per key, see SYMBOL_ICON) in a 24px box, with the same meaning on
 * every page. The shape carries the meaning and has an accessible name; colour is secondary. With `label`, the
 * control name follows the symbol as visible text.
 */
import type { ControlState } from '@model/index';
import { useI18n, type Locale } from '../i18n';
import { SYMBOL_ICON, controlSymbol } from '../lib/symbols';
import Octicon from './Octicon.astro';
interface Props {
  state: ControlState;
  required: boolean;
  locale: Locale;
  /** Visible text after the symbol, e.g. the control name. */
  label?: string;
}
const { state, required, locale, label } = Astro.props;
const { d, f } = useI18n(locale);
const { key, tone } = controlSymbol(state, required);
const meaning = d.symbols[key];
/** The meaning alone when it already says the state; otherwise add the precise state. */
const selfExplaining =
  state === 'enabled' ||
  state === 'failed' ||
  (required && (state === 'stale' || state === 'not-configured'));
const name = selfExplaining
  ? meaning
  : f(d.symbols.withState, { meaning, state: d.controlState[state] });
---

<span class="ctl" data-state={state} data-required={required ? 'true' : 'false'}>
  <span class={`sym sym--${tone}`} role="img" aria-label={name} title={name} data-symbol={key}>
    <Octicon name={SYMBOL_ICON[key]} />
  </span>
  {label && <span class="ctl__label">{label}</span>}
</span>

<style>
  .ctl {
    display: inline-flex;
    align-items: center;
    gap: var(--base-size-8);
  }
  .sym {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--borderRadius-small);
    line-height: 1;
    cursor: default;
  }
  .sym--green {
    background: var(--bgColor-success-muted);
    color: var(--fgColor-success);
  }
  .sym--amber {
    background: var(--bgColor-attention-muted);
    color: var(--fgColor-attention);
  }
  .sym--red {
    background: var(--bgColor-danger-muted);
    color: var(--fgColor-danger);
  }
  .sym--unknown {
    background: transparent;
    color: var(--fgColor-muted);
    border: 1.5px dashed var(--borderColor-emphasis);
  }
  .sym--muted {
    background: transparent;
    color: var(--fgColor-muted);
  }
  @media (forced-colors: active) {
    .sym {
      border: 1px solid CanvasText;
    }
    .sym--unknown {
      border-style: dashed;
    }
  }
</style>
