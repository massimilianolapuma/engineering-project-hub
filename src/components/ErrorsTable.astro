---
import type { CollectionError } from '@model/index';
import type { I18n } from '../i18n';
import Pill from './Pill.astro';
import UnknownValue from './UnknownValue.astro';
interface Props {
  errors: CollectionError[];
  i18n: I18n;
  caption: string;
}
const { errors, i18n, caption } = Astro.props;
const { d } = i18n;
const tone = (c: CollectionError['classification']) =>
  c === 'error' || c === 'rate-limited' ? 'red' : c === 'not-configured' ? 'amber' : 'grey';
---

{errors.length === 0 ? (
  <p class="muted">{d.common.noErrors}</p>
) : (
  <div class="table-wrap">
    <table role="table" class="table">
      <caption class="visually-hidden">{caption}</caption>
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">
            {d.common.repository}
          </th>
          <th role="columnheader" scope="col">
            {d.dataQualityPage.source}
          </th>
          <th role="columnheader" scope="col">
            {d.dataQualityPage.classification}
          </th>
          <th role="columnheader" scope="col" class="num">
            {d.dataQualityPage.http}
          </th>
          <th role="columnheader" scope="col">
            {d.dataQualityPage.detail}
          </th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {errors.map((e) => (
          <tr role="row">
            <td role="cell" data-label={d.common.repository}>
              <code>{e.repository}</code>
            </td>
            <td role="cell" data-label={d.dataQualityPage.source}>
              {d.errorSource[e.source]}
            </td>
            <td role="cell" data-label={d.dataQualityPage.classification}>
              <Pill tone={tone(e.classification)} label={d.errorClass[e.classification]} />
            </td>
            <td role="cell" class="num" data-label={d.dataQualityPage.http}>
              {e.httpStatus ?? <UnknownValue i18n={i18n} />}
            </td>
            <td role="cell" data-label={d.dataQualityPage.detail}>
              {e.detail ?? <UnknownValue i18n={i18n} />}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
