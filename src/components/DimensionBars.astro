---
/**
 * The five health dimensions as 32px bars (4px gap), bottom-aligned in a 12px box. Status is
 * encoded twice, so it never depends on colour alone (WCAG 1.4.1): by colour and by height,
 * the worse the taller (critical full height, attention 2/3, healthy 1/3). Unknown keeps the
 * full height as a dashed outline, never a fill. Each bar has an accessible name
 * ("Security risk: Critical"); the row's pill and reason carry the status as text.
 *
 * `variant="header"` renders the short dimension labels aligned with the bars, for a table
 * header ("labels once in the header"), each with its full name.
 */
import { DimensionSchema, type Dimension, type HealthStatus } from '@model/index';
import { useI18n, type Locale } from '../i18n';
interface Props {
  dims?: { dimension: Dimension; status: HealthStatus }[];
  locale: Locale;
  variant?: 'bars' | 'header';
  /** A sample (e.g. on "How to read"): no accessible names or tooltips, hidden from AT. */
  decorative?: boolean;
}
const { dims = [], locale, variant = 'bars', decorative = false } = Astro.props;
const i18n = useI18n(locale);
const { d } = i18n;
/** Bar height in thirds of the box: the worse the status, the taller the bar. */
const HEIGHT: Record<HealthStatus, 1 | 2 | 3> = { red: 3, amber: 2, green: 1, grey: 3 };
---

{variant === 'header' ? (
  <span class="dimbars dimbars--header">
    {DimensionSchema.options.map((dim) => (
      <abbr class="dimbars__label" title={i18n.dimension(dim)}>
        <span aria-hidden="true">{d.dimensionBars.short[dim]}</span>
        <span class="visually-hidden">{i18n.dimension(dim)}</span>
      </abbr>
    ))}
  </span>
) : (
  <span
    class="dimbars dimbars--bars"
    role={decorative ? undefined : 'group'}
    aria-label={decorative ? undefined : d.dimensionBars.label}
    aria-hidden={decorative ? 'true' : undefined}
  >
    {dims.map(({ dimension, status }) => {
      const label = `${i18n.dimension(dimension)}: ${i18n.status(status)}`;
      return (
        <span
          class={`dimbars__bar dimbars__bar--${status} dimbars__bar--h${HEIGHT[status]}`}
          role={decorative ? undefined : 'img'}
          aria-label={decorative ? undefined : label}
          title={decorative ? undefined : label}
          data-dimension={dimension}
          data-status={status}
          data-height={HEIGHT[status]}
        />
      );
    })}
  </span>
)}

<style>
  .dimbars {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    vertical-align: middle;
  }
  /* Fixed-height box, bars sit on its bottom edge so their heights compare at a glance. */
  .dimbars--bars {
    height: 12px;
    align-items: flex-end;
  }
  .dimbars__bar {
    display: block;
    flex: none;
    width: 32px;
    height: 12px;
    border-radius: var(--radius-sm);
  }
  .dimbars__bar--h2 {
    height: 8px;
  }
  .dimbars__bar--h1 {
    height: 4px;
    border-radius: 2px;
  }
  .dimbars__bar--red {
    background: var(--red);
  }
  .dimbars__bar--amber {
    background: var(--amber);
  }
  .dimbars__bar--green {
    background: var(--green);
  }
  .dimbars__bar--grey {
    background: transparent;
    border: 1.5px dashed var(--unknown);
  }
  .dimbars__label {
    width: 32px;
    flex: none;
    text-align: center;
    text-decoration: none;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-muted);
    cursor: help;
  }
  /* Forced colours drop the fills: keep the bars solid so their heights still read. */
  @media (forced-colors: active) {
    .dimbars__bar {
      forced-color-adjust: none;
      background: CanvasText;
    }
    .dimbars__bar--grey {
      background: transparent;
      border: 1.5px dashed CanvasText;
    }
  }
</style>
