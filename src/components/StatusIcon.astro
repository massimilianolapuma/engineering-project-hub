---
/**
 * Shape-coded status icon: each state has a distinct shape so status never relies on colour
 * alone. Decorative (aria-hidden): the accompanying text carries the meaning.
 */
import type { Tone } from '../lib/tones';
interface Props {
  tone: Tone;
}
const { tone } = Astro.props;
---

<svg
  class={`icon icon--${tone}`}
  viewBox="0 0 16 16"
  width="14"
  height="14"
  aria-hidden="true"
  focusable="false"
>
  {tone === 'green' && (
    <>
      <circle cx="8" cy="8" r="7" fill="currentColor" />
      <path
        d="M4.6 8.3l2.2 2.2 4.6-4.8"
        fill="none"
        stroke="var(--icon-ink)"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </>
  )}
  {tone === 'amber' && (
    <>
      <path d="M8 1.2l7 12.6H1z" fill="currentColor" />
      <path d="M8 5.6v4" stroke="var(--icon-ink)" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="8" cy="11.9" r="1" fill="var(--icon-ink)" />
    </>
  )}
  {tone === 'red' && (
    <>
      <path d="M5.1 1h5.8L15 5.1v5.8L10.9 15H5.1L1 10.9V5.1z" fill="currentColor" />
      <path
        d="M5.6 5.6l4.8 4.8M10.4 5.6l-4.8 4.8"
        stroke="var(--icon-ink)"
        stroke-width="1.8"
        stroke-linecap="round"
      />
    </>
  )}
  {tone === 'grey' && (
    <>
      <rect
        x="1.5"
        y="1.5"
        width="13"
        height="13"
        rx="2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-dasharray="2.4 1.6"
      />
      <path d="M5 8h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </>
  )}
  {tone === 'info' && (
    <>
      <circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path
        d="M8 4.6V8l2.4 1.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      />
    </>
  )}
  {tone === 'muted' && (
    <path d="M3 8h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  )}
</svg>
