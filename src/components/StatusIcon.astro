---
/**
 * Shape-coded status icon: each state has a distinct shape so status never relies on colour
 * alone. Decorative (aria-hidden): the accompanying text carries the meaning.
 * Health tones are Octicons (check-circle-fill, alert-fill, x-circle-fill, question); severity
 * keeps its own 1–4 rising bars, a data glyph that is never a health shape.
 */
import type { SeverityTone, Tone } from '../lib/tones';
import type { OcticonName } from '../lib/octicon';
import Octicon from './Octicon.astro';
interface Props {
  tone: Tone | SeverityTone;
}
const { tone } = Astro.props;
const HEALTH: Partial<Record<Tone | SeverityTone, OcticonName>> = {
  green: 'check-circle-fill',
  amber: 'alert-fill',
  red: 'x-circle-fill',
  grey: 'question',
  info: 'clock',
  muted: 'dash',
};
const octicon = HEALTH[tone];
/** Severity glyph: 1–4 rising bars (signal-strength shape), never a health shape. */
const bars = { 'sev-low': 1, 'sev-medium': 2, 'sev-high': 3, 'sev-critical': 4 } as Record<
  string,
  number
>;
const level = bars[tone] ?? 0;
---

{octicon ? (
  <Octicon name={octicon} class={`icon icon--${tone}`} />
) : (
  <svg
    class={`icon icon--${tone}`}
    viewBox="0 0 16 16"
    width="14"
    height="14"
    aria-hidden="true"
    focusable="false"
  >
    {[0, 1, 2, 3].map((i) => (
      <rect
        x={1.5 + i * 3.5}
        y={11 - i * 3}
        width="2.6"
        height={3.5 + i * 3}
        rx="0.6"
        fill={i < level ? 'currentColor' : 'none'}
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray={level === 0 ? '1.4 1' : undefined}
      />
    ))}
  </svg>
)}
