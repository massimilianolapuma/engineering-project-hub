---
/**
 * Status icon (formerly a status dot): the same Octicon the status pills use, so each state has
 * its own shape — x-circle (critical), alert (attention), check-circle (healthy), question
 * (unknown, never a fill). It carries an accessible name, but it always sits next to a text
 * label or pill: colour is never the only carrier of status.
 */
import type { HealthStatus } from '@model/index';
import type { OcticonName } from '../lib/octicon';
import Octicon from './Octicon.astro';
interface Props {
  status: HealthStatus;
  label: string;
}
const { status, label } = Astro.props;
const ICON: Record<HealthStatus, OcticonName> = {
  red: 'x-circle-fill',
  amber: 'alert-fill',
  green: 'check-circle-fill',
  grey: 'question',
};
---

<span
  class={`status-icon status-icon--${status}`}
  role="img"
  aria-label={label}
  title={label}
  data-status={status}
>
  <Octicon name={ICON[status]} class={`icon icon--${status}`} />
</span>

<style>
  .status-icon {
    display: inline-flex;
    flex: none;
    line-height: 0;
    vertical-align: middle;
  }
</style>
