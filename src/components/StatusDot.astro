---
/**
 * Status dot: a 10px filled circle for red / amber / green, a dashed outline for grey
 * (unknown is never a fill, never calmer than a gap). It carries an accessible name, but it
 * always sits next to a text label or pill: colour is never the only carrier of status.
 */
import type { HealthStatus } from '@model/index';
interface Props {
  status: HealthStatus;
  label: string;
}
const { status, label } = Astro.props;
---

<span
  class={`dot dot--${status}`}
  role="img"
  aria-label={label}
  title={label}
  data-status={status}
></span>

<style>
  .dot {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    vertical-align: middle;
  }
  .dot--red {
    background: var(--red);
  }
  .dot--amber {
    background: var(--amber);
  }
  .dot--green {
    background: var(--green);
  }
  .dot--grey {
    background: transparent;
    border: 1.5px dashed var(--unknown);
  }
  @media (forced-colors: active) {
    .dot {
      border: 1.5px solid CanvasText;
    }
    .dot--grey {
      border-style: dashed;
    }
  }
</style>
