---
/**
 * Score sparkline: inline SVG on a fixed 0-100 scale. The accessible name summarises the
 * values; the numbers are always written next to it by the caller. A null score is a gap (the
 * line breaks, it never drops to 0) and a lone point is a dot (round caps on a zero-length line).
 * The line is muted; with `tone`, the last collection is a dot in its status colour (the state is
 * always written next to the chart, so colour is never the only sign).
 */
import type { HealthStatus } from '@model/index';
import { sparklineEnd, sparklineSegments } from '../lib/trend';
interface Props {
  scores: (number | null)[];
  width: number;
  height: number;
  label: string;
  /** Faint 0 and 100 guide lines (the large variant on the project page). */
  guides?: boolean;
  /** Status of the latest collection: draws the end dot. */
  tone?: HealthStatus;
}
const { scores, width, height, label, guides = false, tone } = Astro.props;
const pad = 3;
const segments = sparklineSegments(scores, width - 2 * pad, height - 2 * pad);
const end =
  tone && tone !== 'grey' ? sparklineEnd(scores, width - 2 * pad, height - 2 * pad) : null;
---

<svg
  class="spark"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  role="img"
  aria-label={label}
  focusable="false"
>
  {guides && (
    <>
      <line class="spark__guide" x1="0" x2={width} y1={pad} y2={pad} />
      <line class="spark__guide" x1="0" x2={width} y1={height - pad} y2={height - pad} />
    </>
  )}
  <g transform={`translate(${pad} ${pad})`}>
    {segments.map((d) => (
      <path class="spark__line" d={d} />
    ))}
    {end && <circle class={`spark__end spark__end--${tone}`} cx={end.x} cy={end.y} r="3.5" />}
  </g>
</svg>

<style>
  .spark {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }
  .spark__line {
    fill: none;
    stroke: var(--fgColor-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .spark__guide {
    stroke: var(--borderColor-muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  /* 2px surface ring keeps the dot readable where it sits on the line. */
  .spark__end {
    stroke: var(--bgColor-default);
    stroke-width: 2;
    paint-order: stroke;
  }
  .spark__end--red {
    fill: var(--fgColor-danger);
  }
  .spark__end--amber {
    fill: var(--fgColor-attention);
  }
  .spark__end--green {
    fill: var(--fgColor-success);
  }
  @media (forced-colors: active) {
    .spark__line {
      stroke: CanvasText;
    }
    .spark__end {
      fill: CanvasText;
    }
  }
</style>
