---
/**
 * One-line legend placed under a page's list, with a link to the "How to read" page, which
 * holds the full explanation (states, symbols, score, thresholds).
 * `status`: the four health states (dots). `symbols`: the six control symbols.
 */
import type { I18n } from '../i18n';
import { href } from '../lib/routes';
import type { ControlGlyph } from '../lib/symbols';
import { GLYPH_KEY } from '../lib/symbols';
interface Props {
  i18n: I18n;
  kind?: 'status' | 'symbols';
}
const { i18n, kind = 'status' } = Astro.props;
const { d, locale } = i18n;
const l = d.legend;
const id = `legend-${kind}`;
const glyphs: ControlGlyph[] = ['✓', '!', '⧖', '✕', '?', '–'];
---

<aside class={`legend legend--${kind}`} aria-labelledby={id}>
  <h2 id={id} class="visually-hidden">
    {l.title}
  </h2>
  <ul class="legend__items">
    {kind === 'status'
      ? (['red', 'amber', 'green', 'grey'] as const).map((s) => (
          <li>
            <span class={`legend__dot legend__dot--${s}`} aria-hidden="true" />
            {s === 'grey' ? l.unknownDashed : i18n.status(s)}
          </li>
        ))
      : glyphs.map((g) => (
          <li>
            <span class="legend__glyph" aria-hidden="true">
              {g}
            </span>
            {d.symbols[GLYPH_KEY[g]]}
          </li>
        ))}
  </ul>
  <a class="legend__link" href={href(locale, 'howToRead')}>
    {kind === 'status' ? l.scoreHow : l.howToRead}
  </a>
</aside>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
  .legend__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legend__items li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend__dot {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .legend__dot--red {
    background: var(--red);
  }
  .legend__dot--amber {
    background: var(--amber);
  }
  .legend__dot--green {
    background: var(--green);
  }
  .legend__dot--grey {
    border: 1.5px dashed var(--unknown);
  }
  .legend__glyph {
    min-width: 1ch;
    font-weight: 700;
    color: var(--text);
    text-align: center;
  }
  .legend__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
</style>
