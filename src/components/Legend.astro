---
/**
 * One-line legend placed under a page's list, with a link to the "How to read" page, which
 * holds the full explanation (states, symbols, score, thresholds).
 * `status`: the four health states (dots). `symbols`: the six control symbols.
 */
import type { I18n } from '../i18n';
import { href } from '../lib/routes';
import { SYMBOL_ICON, type SymbolKey } from '../lib/symbols';
import Octicon from './Octicon.astro';
import StatusIcon from './StatusIcon.astro';
interface Props {
  i18n: I18n;
  kind?: 'status' | 'symbols';
}
const { i18n, kind = 'status' } = Astro.props;
const { d, locale } = i18n;
const l = d.legend;
const id = `legend-${kind}`;
const keys: SymbolKey[] = ['ok', 'gap', 'stale', 'failed', 'blind', 'na'];
---

<aside class={`legend legend--${kind}`} aria-labelledby={id}>
  <h2 id={id} class="visually-hidden">
    {l.title}
  </h2>
  <ul class="legend__items">
    {kind === 'status'
      ? (['red', 'amber', 'green', 'grey'] as const).map((s) => (
          <li>
            <StatusIcon tone={s} />
            {s === 'grey' ? l.unknownDashed : i18n.status(s)}
          </li>
        ))
      : keys.map((k) => (
          <li data-symbol={k}>
            <span class={`legend__glyph legend__glyph--${k}`}>
              <Octicon name={SYMBOL_ICON[k]} />
            </span>
            {d.symbols[k]}
          </li>
        ))}
  </ul>
  <a class="legend__link" href={href(locale, 'howToRead')}>
    {kind === 'status' ? l.scoreHow : l.howToRead}
  </a>
</aside>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--base-size-8) var(--base-size-16);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fgColor-muted);
    font-size: var(--text-body-size-small);
  }
  .legend__items {
    display: flex;
    flex-wrap: wrap;
    gap: var(--base-size-8) var(--base-size-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .legend__items li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .legend__glyph {
    display: inline-flex;
    color: var(--fgColor-default);
  }
  .legend__glyph--blind {
    color: var(--fgColor-muted);
  }
  .legend__link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
</style>
