---
/**
 * Legend, always visible: a compact strip under the header on every page, with an
 * expandable explanation of every state and special label.
 */
import type { I18n } from '../i18n';
import StatusBadge from './StatusBadge.astro';
import StatusIcon from './StatusIcon.astro';
interface Props {
  i18n: I18n;
  /** `strip`: compact bar under the header. `sheet`: the margin legend of the portfolio sheet. */
  variant?: 'strip' | 'sheet';
}
const { i18n, variant = 'strip' } = Astro.props;
const l = i18n.d.legend;
const labels = [
  { tone: 'grey', text: l.unknownLabel },
  { tone: 'muted', text: l.notConfiguredLabel },
  { tone: 'grey', text: l.notAuthorisedLabel },
  { tone: 'green', text: l.noOpenAlertsLabel },
  { tone: 'red', text: l.collectionFailedLabel },
] as const;
---

{variant === 'sheet' ? (
  <aside class="legend" data-variant="sheet" aria-labelledby="legend-title">
    <h2 id="legend-title" class="sheet-head">
      {l.title}
    </h2>
    <ul class="legend__keys">
      {(['red', 'amber', 'green', 'grey'] as const).map((s) => (
        <li>
          <span class={`legend__swatch legend__swatch--${s}`} aria-hidden="true" />
          <span>
            <StatusBadge status={s} i18n={i18n} size="sm" />
            <span class="sub">{i18n.statusDesc(s)}</span>
          </span>
        </li>
      ))}
      <li>
        <span class="legend__swatch legend__swatch--grey" aria-hidden="true" />
        <span class="sub">{l.unsurveyedLabel}</span>
      </li>
      <li>
        <span class="legend__swatch legend__swatch--blind" aria-hidden="true" />
        <span class="sub">{l.blindLabel}</span>
      </li>
      <li>
        <StatusIcon tone="grey" />
        <span class="sub">{l.notAuthorisedLabel}</span>
      </li>
      <li>
        <StatusIcon tone="muted" />
        <span class="sub">{l.notConfiguredLabel}</span>
      </li>
    </ul>
    <p class="legend__note">{l.note}</p>
  </aside>
) : (
  <aside class="legend" aria-labelledby="legend-title">
    <div class="legend__inner">
      <h2 id="legend-title" class="legend__title">
        {l.title}
      </h2>
      <ul class="legend__list">
        {(['green', 'amber', 'red', 'grey'] as const).map((s) => (
          <li>
            <StatusBadge status={s} i18n={i18n} size="sm" />
          </li>
        ))}
      </ul>
      <details class="legend__details">
        <summary>{l.more}</summary>
        <ul class="legend__defs">
          {(['red', 'amber', 'green', 'grey'] as const).map((s) => (
            <li>
              <StatusIcon tone={s} /> {i18n.statusDesc(s)}
            </li>
          ))}
          {labels.map((x) => (
            <li>
              <StatusIcon tone={x.tone} /> {x.text}
            </li>
          ))}
        </ul>
        <p class="legend__note">{l.note}</p>
      </details>
    </div>
  </aside>
)}
