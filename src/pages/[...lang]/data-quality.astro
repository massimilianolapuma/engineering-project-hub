---
import {
  CapabilitySchema,
  ErrorClassificationSchema,
  type Availability,
  type CollectionError,
  type ErrorClassification,
} from '@model/index';
import ErrorState from '../../components/ErrorState.astro';
import ErrorsTable from '../../components/ErrorsTable.astro';
import ExtLink from '../../components/ExtLink.astro';
import Pill from '../../components/Pill.astro';
import Base from '../../layouts/Base.astro';
import { healthRank } from '../../lib/format';
import { pageContext } from '../../lib/page';
import { href, localeParams } from '../../lib/routes';
import type { Tone } from '../../lib/tones';

export const getStaticPaths = localeParams;
const { locale } = Astro.props;
const { i18n, data, index, alternates } = pageContext(locale, 'dataQuality');
const { d, f } = i18n;
const q = d.dataQualityPage;

const PERMISSIONS_GUIDE =
  'https://docs.github.com/en/rest/authentication/permissions-required-for-github-apps';
const DAY_MS = 86_400_000;

/** Singular / plural pick for "{count} …" templates. */
const plural = (n: number, one: string, other: string) =>
  f(n === 1 ? one : other, { count: i18n.number(n) });
/** "owner/name" → "name": the organisation is the same for every row. */
const repoName = (full: string) => full.slice(full.indexOf('/') + 1);
const dayFmt = new Intl.DateTimeFormat(locale === 'it' ? 'it-IT' : 'en-GB', {
  dateStyle: 'medium',
  timeZone: 'UTC',
});
const day = (iso: string) => dayFmt.format(new Date(iso));

/** Projects worst first (red, amber, unknown, healthy), then by name. */
const projects = data.ok
  ? [...data.data.projects].sort(
      (a, b) =>
        healthRank(a.overallHealth.status) - healthRank(b.overallHealth.status) ||
        a.project.name.localeCompare(b.project.name),
    )
  : [];

/* What we could not read, grouped by classification, then by project and source. */
interface CauseRow {
  projectId: string;
  projectName: string;
  source: CollectionError['source'];
  repositories: string[];
}
const causes = ErrorClassificationSchema.options
  .map((classification, order) => {
    const rows: CauseRow[] = [];
    let sources = 0;
    for (const p of projects) {
      for (const e of p.collectionErrors.filter((x) => x.classification === classification)) {
        sources += 1;
        const row = rows.find((r) => r.projectId === p.project.id && r.source === e.source);
        if (row) {
          if (!row.repositories.includes(e.repository)) row.repositories.push(e.repository);
        } else
          rows.push({
            projectId: p.project.id,
            projectName: p.project.name,
            source: e.source,
            repositories: [e.repository],
          });
      }
    }
    return { classification, order, sources, rows };
  })
  .filter((c) => c.sources > 0)
  .sort((a, b) => b.sources - a.sources || a.order - b.order);
const causeTone = (c: ErrorClassification): Tone =>
  c === 'error' || c === 'rate-limited' ? 'red' : c === 'not-configured' ? 'amber' : 'grey';
const unreadable = causes.reduce((n, c) => n + c.sources, 0);
const unreadableProjects = projects.filter((p) => p.collectionErrors.length > 0).length;
const accessCauses = causes.some(
  (c) => c.classification === 'not-authorised' || c.classification === 'not-found',
);

/* Stale sources, with their age at collection time (unknown when the source has no date). */
const stale = projects.flatMap((p) =>
  p.dataFreshness.staleSources.map((s) => ({
    project: p.project,
    repository: s.repository,
    source: s.source,
    lastUpdatedAt: s.lastUpdatedAt,
    days: s.lastUpdatedAt
      ? Math.max(
          0,
          Math.floor(
            (Date.parse(p.dataFreshness.collectedAt) - Date.parse(s.lastUpdatedAt)) / DAY_MS,
          ),
        )
      : null,
  })),
);

/* Submodules the catalog does not map, or whose pin cannot be resolved. */
const submodules = projects.flatMap((p) =>
  p.coordinator.submodules
    .filter((m) => m.association === 'unmapped' || m.status !== 'resolved')
    .map((m) => ({ project: p.project, ...m })),
);
const [beforeFile, afterFile] = q.unmappedSentence.split('{file}');
const [beforeDate, afterDate] = q.lastUpdate.split('{date}');

/* Collection capabilities, worst first. */
const AVAIL_RANK: Record<Availability, number> = {
  'not-authorised': 0,
  unknown: 1,
  partial: 2,
  available: 3,
  'not-used': 4,
};
const availTone = (a: Availability): Tone =>
  a === 'available' ? 'green' : a === 'partial' ? 'amber' : a === 'not-used' ? 'muted' : 'grey';
const capabilities = index
  ? CapabilitySchema.options
      .map((c, order) => ({ c, order, a: index.run.capabilities[c] }))
      .sort((x, y) => AVAIL_RANK[x.a] - AVAIL_RANK[y.a] || x.order - y.order)
  : [];

const lead = [
  unreadable > 0 &&
    `${plural(unreadable, q.unreadableOne, q.unreadableOther)} ${plural(
      unreadableProjects,
      q.inProjectsOne,
      q.inProjectsOther,
    )}`,
  stale.length > 0 && plural(stale.length, q.staleOne, q.staleOther),
]
  .filter(Boolean)
  .join(' · ');
---

<Base i18n={i18n} title={q.title} page="dataQuality" alternates={alternates} index={index}>
  {!data.ok && <ErrorState error={data.error} i18n={i18n} />}
  {data.ok && index && (
    <div class="dq">
      <header class="page-head dq-head">
        <h1>{q.title}</h1>
        <p class="dq-lead">{lead || q.leadClean}</p>
        <p class="muted dq-intro">{q.intro}</p>
      </header>

      <section aria-label={q.repoCounts}>
        <ul class="dq-counts">
          <li class="dq-count" data-repo-count="total">
            <span class="dq-count__value">{i18n.number(index.run.repositories.total)}</span>
            <span class="muted">{q.reposTotal}</span>
          </li>
          <li class="dq-count dq-count--green" data-repo-count="full">
            <span class="dq-count__value">{i18n.number(index.run.repositories.ok)}</span>
            <span class="muted">{q.reposFull}</span>
          </li>
          <li class="dq-count dq-count--amber" data-repo-count="partial">
            <span class="dq-count__value">{i18n.number(index.run.repositories.withErrors)}</span>
            <span class="muted">{q.reposPartial}</span>
          </li>
          <li class="dq-count dq-count--unknown" data-repo-count="unreadable">
            <span class="dq-count__value">{i18n.number(index.run.repositories.unavailable)}</span>
            <span class="muted">{q.reposUnreadable}</span>
          </li>
        </ul>
      </section>

      <section class="card dq-card" aria-labelledby="h-cause">
        <h2 id="h-cause">{q.byCause}</h2>
        {causes.length === 0 ? (
          <p class="muted">{q.noUnreadable}</p>
        ) : (
          <>
            {causes.map((c) => (
              <div class="dq-cause" data-cause={c.classification} data-sources={c.sources}>
                <p class="dq-cause__head">
                  <Pill tone={causeTone(c.classification)} label={d.errorClass[c.classification]} />
                  <span class="muted">
                    {plural(c.sources, q.sourcesOne, q.sourcesOther)} ·{' '}
                    {q.causeWhy[c.classification]}
                  </span>
                </p>
                <ul class="dq-rows">
                  {c.rows.map((r) => (
                    <li class="dq-row">
                      <span>
                        <a class="dq-project" href={href(locale, `projects/${r.projectId}`)}>
                          {r.projectName}
                        </a>
                      </span>
                      <span>{d.errorSource[r.source]}</span>
                      <span class="mono dq-repos">{r.repositories.map(repoName).join(', ')}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            {accessCauses && (
              <p class="muted dq-fix">
                {q.howToFix}{' '}
                <ExtLink href={PERMISSIONS_GUIDE} i18n={i18n} label={q.permissionsGuide} />
              </p>
            )}
          </>
        )}
      </section>

      <section class="card dq-card" aria-labelledby="h-stale">
        <h2 id="h-stale">{q.stale}</h2>
        {stale.length === 0 ? (
          <p class="muted">{q.noStale}</p>
        ) : (
          <ul class="dq-rows">
            {stale.map((s) => (
              <li class="dq-row">
                <span>
                  <a class="dq-project" href={href(locale, `projects/${s.project.id}`)}>
                    {s.project.name}
                  </a>{' '}
                  · <span class="mono">{repoName(s.repository)}</span>
                </span>
                <span>{d.errorSource[s.source]}</span>
                <span class="dq-age">
                  {s.days !== null && s.lastUpdatedAt ? (
                    <>
                      <span class="status-col">
                        <Pill tone="amber" label={plural(s.days, q.ageOne, q.ageOther)} />
                      </span>
                      <span>
                        {beforeDate}
                        <time datetime={s.lastUpdatedAt}>{day(s.lastUpdatedAt)}</time>
                        {afterDate}
                      </span>
                    </>
                  ) : (
                    <span class="status-col">
                      <Pill tone="grey" label={d.common.unknown} />
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card dq-card" aria-labelledby="h-submodules">
        <h2 id="h-submodules">{q.submodules}</h2>
        {submodules.length === 0 ? (
          <p class="muted">{q.noSubmodules}</p>
        ) : (
          <ul class="dq-rows">
            {submodules.map((m) => (
              <li class="dq-row">
                <span>
                  <a class="dq-project" href={href(locale, `projects/${m.project.id}`)}>
                    {m.project.name}
                  </a>
                </span>
                <span class="mono">{m.path}</span>
                <span>
                  {m.association === 'unmapped' ? (
                    <>
                      {beforeFile}
                      <code>.gitmodules</code>
                      {afterFile} <a href={href(locale, 'catalog')}>{q.addToCatalog}</a>
                    </>
                  ) : (
                    <>
                      <Pill
                        tone={m.status === 'unresolvable' ? 'red' : 'grey'}
                        label={d.submoduleStatus[m.status]}
                      />{' '}
                      {q.unresolvedSentence}
                    </>
                  )}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="card dq-card" aria-labelledby="h-cap">
        <h2 id="h-cap">{q.capabilities}</h2>
        <ul class="dq-caps">
          {capabilities.map(({ c, a }) => (
            <li class="dq-cap">
              <Pill tone={availTone(a)} label={d.availability[a]} />
              <span>{d.capability[c]}</span>
            </li>
          ))}
        </ul>
      </section>

      <details class="dq-run">
        <summary>
          {f(q.runSummary, {
            date: i18n.date(index.run.startedAt),
            source: index.run.dataSource === 'mock' ? q.synthetic : q.live,
            version: index.run.collectorVersion,
          })}
        </summary>
        <div class="dq-run__body">
          <h2 class="h3">{q.run}</h2>
          <dl class="facts">
            <div>
              <dt>{q.started}</dt>
              <dd>{i18n.date(index.run.startedAt)}</dd>
            </div>
            <div>
              <dt>{q.duration}</dt>
              <dd>{(index.run.durationMs / 1000).toFixed(1)} s</dd>
            </div>
            <div>
              <dt>{d.common.source}</dt>
              <dd>
                {index.run.dataSource === 'mock' ? d.common.sourceMock : d.common.sourceGithub}
              </dd>
            </div>
            <div>
              <dt>{d.common.auth}</dt>
              <dd>{d.authMode[index.run.authenticationMode]}</dd>
            </div>
            <div>
              <dt>{q.collectorVersion}</dt>
              <dd>
                <code>{index.run.collectorVersion}</code>
              </dd>
            </div>
            <div>
              <dt>{q.audience}</dt>
              <dd>
                {index.run.policy.audience === 'public' ? q.audiencePublic : q.audienceRestricted}
              </dd>
            </div>
            <div>
              <dt>{q.config}</dt>
              <dd>
                <Pill
                  tone={index.run.configValid ? 'green' : 'red'}
                  label={index.run.configValid ? q.configValid : q.configInvalid}
                />
              </dd>
            </div>
          </dl>
          {projects
            .filter((p) => p.collectionErrors.length > 0)
            .map((p) => (
              <>
                <h3>
                  {q.errors} ·{' '}
                  <a href={href(locale, `projects/${p.project.id}`)}>{p.project.name}</a>
                </h3>
                <ErrorsTable
                  errors={p.collectionErrors}
                  i18n={i18n}
                  caption={`${q.errors} — ${p.project.name}`}
                />
              </>
            ))}
        </div>
      </details>
    </div>
  )}
</Base>

<style>
  .dq {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .dq > section,
  .dq > .card {
    margin: 0;
  }
  .dq-head {
    margin-bottom: var(--space-2);
  }
  .dq-head h1 {
    margin: 0;
  }
  .dq-lead {
    margin: 6px 0 0;
    font-size: 1.0625rem;
    line-height: 24px;
    font-weight: 600;
  }
  .dq-intro {
    margin: var(--space-1) 0 0;
  }
  .dq-counts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dq-count {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .dq-count__value {
    font-size: 1.75rem;
    line-height: 34px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .dq-count--green .dq-count__value {
    color: var(--green-text);
  }
  .dq-count--amber .dq-count__value {
    color: var(--amber-text);
  }
  /* Unreadable is unknown: dashed outline, never a fill and never calmer than a gap. */
  .dq-count--unknown {
    border: 1.5px dashed var(--unknown);
  }
  .dq-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }
  .dq-card h2 {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 22px;
  }
  .dq-card > p {
    margin: 0;
  }
  .dq-cause__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) 10px;
    margin: 0 0 var(--space-1);
  }
  .dq-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dq-row {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--space-3);
    padding: 10px 0;
    border-top: 1px solid var(--border);
    align-items: start;
  }
  .dq-row:first-child {
    border-top: 0;
  }
  .dq-project {
    font-weight: 600;
  }
  .dq-repos {
    overflow-wrap: anywhere;
  }
  .dq-age {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  .dq-fix {
    font-size: var(--fs-sm);
  }
  .dq-caps {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dq-cap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .dq-run {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .dq-run summary {
    cursor: pointer;
    min-height: 44px;
    padding: 12px var(--space-4);
    font-weight: 600;
  }
  .dq-run__body {
    padding: 0 var(--space-4) var(--space-4);
  }
  .dq-run__body h3 {
    margin-top: var(--space-5);
  }
  @media (max-width: 640px) {
    .dq-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }
</style>
