---
import type { HealthStatus, ProjectSnapshot, Reason } from '@model/index';
import Count from '../../components/Count.astro';
import ErrorState from '../../components/ErrorState.astro';
import Legend from '../../components/Legend.astro';
import Pill from '../../components/Pill.astro';
import RelTime from '../../components/RelTime.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StatusIcon from '../../components/StatusIcon.astro';
import Base from '../../layouts/Base.astro';
import { healthRank } from '../../lib/format';
import { pageContext } from '../../lib/page';
import { href, localeParams } from '../../lib/routes';
import { controlTone } from '../../lib/tones';

export const getStaticPaths = localeParams;
const { locale } = Astro.props;
const { i18n, data, index, alternates } = pageContext(locale, 'portfolio');
const { d } = i18n;
const projects = data.ok ? data.data.index.projects : [];
type Project = (typeof projects)[number];
const snapshots = new Map<string, ProjectSnapshot>(
  data.ok ? data.data.projects.map((p) => [p.project.id, p]) : [],
);
const staleHours = index?.run.policy.snapshotStaleHours ?? 24;
const units = [...new Set(projects.map((p) => p.businessUnit))].sort();
const lifecycles = [...new Set(projects.map((p) => p.lifecycle))];
const tally = (s: HealthStatus) => projects.filter((p) => p.overall === s).length;
const sorted = [...projects].sort(
  (a, b) => healthRank(a.overall) - healthRank(b.overall) || a.name.localeCompare(b.name),
);

/* The sheet: grid letters A–F are the dimensions, row numbers the projects (worst first). */
type Dim = 'overall' | 'delivery' | 'version' | 'security' | 'coverage' | 'governance';
const DIMS: { key: Dim; ref: string }[] = [
  { key: 'overall', ref: 'A' },
  { key: 'delivery', ref: 'B' },
  { key: 'version', ref: 'C' },
  { key: 'security', ref: 'D' },
  { key: 'coverage', ref: 'E' },
  { key: 'governance', ref: 'F' },
];
const health = (s: ProjectSnapshot | undefined, k: Dim) => {
  if (!s) return null;
  return {
    overall: s.overallHealth,
    delivery: s.deliveryHealth,
    version: s.versionHealth,
    security: s.securityHealth,
    coverage: s.securityCoverage,
    governance: s.governanceHealth,
  }[k];
};
/** The reason that explains the cell: one at the cell's own level first. */
const topReason = (status: HealthStatus, reasons: Reason[]): Reason | undefined =>
  reasons.find((r) => r.level === status) ?? reasons.find((r) => r.level !== 'info') ?? reasons[0];
const statusOf = (p: Project, k: Dim): HealthStatus =>
  k === 'coverage' ? p.coverage.status : p[k];
const unsurveyed = (p: Project) => DIMS.every((x) => statusOf(p, x.key) === 'grey');
/** Why a row could not be surveyed, from the repository-level collection errors. */
const cause = (p: Project): string | null => {
  const errs = snapshots.get(p.id)?.collectionErrors.filter((e) => e.source === 'repository') ?? [];
  if (errs.length === 0) return null;
  const byClass = new Map<string, number>();
  for (const e of errs) byClass.set(e.classification, (byClass.get(e.classification) ?? 0) + 1);
  const list = [...byClass]
    .map(([c, n]) => `${n} ${d.errorClass[c as keyof typeof d.errorClass].toLowerCase()}`)
    .join(', ');
  return i18n.f(d.portfolio.causeRepos, { list });
};
const blind = (p: Project) => controlTone(p.secretScanning) === 'blind';

/*
 * Sheet notes, keyed by grid reference: every Critical cell and every blind spot (the worst
 * Attention cell when nothing is Critical). A note adds what the cell cannot hold: the next
 * reasons, not the one already printed in the cell.
 */
type Note = { p: Project; ref: string; cell: Dim; status: HealthStatus; text: string | null };
const notes: Note[] = sorted.flatMap((p, i) => {
  const row = i + 1;
  if (p.overall === 'green') return [];
  if (unsurveyed(p))
    return [
      {
        p,
        ref: `B${row}–F${row}`,
        cell: 'overall' as Dim,
        status: 'grey' as HealthStatus,
        text: cause(p) ?? d.portfolio.notSurveyedBody,
      },
    ];
  const s = snapshots.get(p.id);
  const cells = DIMS.slice(1).map((x) => ({ ...x, status: statusOf(p, x.key) }));
  const red = cells.filter((c) => c.status === 'red');
  const targets = red.length
    ? red
    : [...cells].sort((a, b) => healthRank(a.status) - healthRank(b.status)).slice(0, 1);
  const out: Note[] = targets.map((c) => {
    const reasons = health(s, c.key)?.reasons ?? [];
    const top = topReason(c.status, reasons);
    const extra = reasons.filter((r) => r !== top && r.level !== 'info');
    const text = extra[0]
      ? `${i18n.reason(extra[0])}${extra.length > 1 ? ` ${i18n.f(d.portfolio.noteMore, { count: extra.length - 1 })}` : ''}`
      : null;
    return { p, ref: `${c.ref}${row}`, cell: c.key, status: c.status, text };
  });
  const blindText = `${d.control.secretScanning}: ${d.portfolio.blindSpot} (${d.controlState[p.secretScanning].toLowerCase()})`;
  const dNote = out.find((n) => n.cell === 'security');
  if (blind(p) && dNote) dNote.text = dNote.text ? `${dNote.text} · ${blindText}` : blindText;
  else if (blind(p))
    out.push({
      p,
      ref: `D${row}`,
      cell: 'security',
      status: 'amber',
      text: `${d.control.secretScanning}: ${d.portfolio.blindSpot} (${d.controlState[p.secretScanning].toLowerCase()})`,
    });
  return out;
});
const surveyedAt = index
  ? `${index.generatedAt.slice(0, 10)} ${index.generatedAt.slice(11, 16)} UTC`
  : null;
---

<Base
  i18n={i18n}
  title={d.portfolio.title}
  page="portfolio"
  alternates={alternates}
  index={index}
  legend={false}
>
  {!data.ok ? (
    <ErrorState error={data.error} i18n={i18n} />
  ) : (
    <>
      <header class="sheet-title">
        <div class="sheet-title__text">
          <h1>{d.portfolio.title}</h1>
          <p class="sheet-title__lead">{d.portfolio.intro}</p>
        </div>
        <div class="sheet-counts" role="group" aria-label={d.portfolio.countsLabel}>
          <button type="button" class="sheet-count" data-health-filter="" aria-pressed="true">
            <span class="sheet-count__value">{projects.length}</span>
            <span>{d.portfolio.showAll}</span>
          </button>
          {(['red', 'grey', 'amber', 'green'] as const).map((s) => (
            <button
              type="button"
              class={`sheet-count sheet-count--${s}`}
              data-health-filter={s}
              aria-pressed="false"
            >
              <span class="sheet-count__value">{tally(s)}</span>
              <StatusIcon tone={s} />
              <span>{i18n.status(s)}</span>
            </button>
          ))}
        </div>
      </header>

      <div class="filters-row">
        <form class="filters filters--sheet" data-portfolio-filters role="search">
          <div class="field field--grow">
            <label for="f-q">{d.portfolio.search}</label>
            <input
              id="f-q"
              name="q"
              type="search"
              placeholder={d.portfolio.searchPlaceholder}
              autocomplete="off"
            />
          </div>
          <div class="field">
            <label for="f-health">{d.portfolio.filterHealth}</label>
            <select id="f-health" name="health">
              <option value="">{d.portfolio.all}</option>
              {(['red', 'amber', 'green', 'grey'] as const).map((s) => (
                <option value={s}>{i18n.status(s)}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="f-bu">{d.portfolio.filterBu}</label>
            <select id="f-bu" name="bu">
              <option value="">{d.portfolio.all}</option>
              {units.map((u) => (
                <option value={u}>{u}</option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="f-sort">{d.portfolio.sort}</label>
            <select id="f-sort" name="sort">
              <option value="health">{d.portfolio.sortHealth}</option>
              <option value="name">{d.portfolio.sortName}</option>
              <option value="updated">{d.portfolio.sortUpdated}</option>
              <option value="critical">{d.portfolio.sortCritical}</option>
            </select>
          </div>
          <details class="filters__more">
            <summary>{d.portfolio.moreFilters}</summary>
            <div class="filters__more-body">
              <div class="field">
                <label for="f-lc">{d.portfolio.filterLifecycle}</label>
                <select id="f-lc" name="lifecycle">
                  <option value="">{d.portfolio.all}</option>
                  {lifecycles.map((l) => (
                    <option value={l}>{d.lifecycle[l]}</option>
                  ))}
                </select>
              </div>
              <div class="field">
                <label for="f-sev">{d.portfolio.filterSeverity}</label>
                <select id="f-sev" name="severity">
                  <option value="">{d.portfolio.all}</option>
                  <option value="critical">{d.portfolio.filterSeverityCritical}</option>
                  <option value="high">{d.portfolio.filterSeverityHigh}</option>
                </select>
              </div>
            </div>
          </details>
        </form>
        <p class="results" aria-live="polite" data-results data-template={d.portfolio.results}>
          {i18n.f(d.portfolio.results, { shown: projects.length, total: projects.length })}
        </p>
      </div>

      <div class="sheet-layout">
        <section class="sheet" aria-labelledby="sheet-title">
          <h2 id="sheet-title" class="sheet__bar sheet-head">
            {d.portfolio.sheetTitle}
          </h2>
          <div class="sheet__scroll">
            <table class="table table--portfolio table--sheet" data-portfolio-table>
              <caption class="visually-hidden">{d.portfolio.tableCaption}</caption>
              <colgroup>
                <col class="sheet__col-project" />
                <col class="sheet__col-overall" />
                {DIMS.slice(1).map(() => (
                  <col />
                ))}
              </colgroup>
              <thead>
                <tr class="sheet__refs" aria-hidden="true">
                  <td />
                  {DIMS.map((x) => (
                    <td>{x.ref}</td>
                  ))}
                </tr>
                <tr>
                  <th scope="col">{d.portfolio.colProject}</th>
                  {DIMS.map((x) => (
                    <th scope="col" class={x.key === 'overall' ? 'sheet__overall' : undefined}>
                      {d.dimensions[x.key]}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {sorted.map((p, i) => {
                  const s = snapshots.get(p.id);
                  const row = i + 1;
                  const why = cause(p);
                  return (
                    <tr
                      data-project
                      data-name={p.name.toLowerCase()}
                      data-health={p.overall}
                      data-rank={healthRank(p.overall)}
                      data-bu={p.businessUnit}
                      data-lifecycle={p.lifecycle}
                      data-critical={p.openCounts.critical ?? -1}
                      data-high={p.openCounts.high ?? -1}
                      data-updated={p.collectedAt}
                      class={`sheet__row sheet__row--${p.overall}`}
                    >
                      <th scope="row" data-label={d.portfolio.colProject}>
                        <span class="sheet__rowref" aria-hidden="true">
                          {row}
                        </span>
                        <a class="project-link" href={href(locale, `projects/${p.id}`)}>
                          {p.name}
                        </a>
                        <span class="sub">
                          {p.businessUnit} · {d.lifecycle[p.lifecycle]}
                        </span>
                        <span class="sub">
                          <RelTime iso={p.collectedAt} i18n={i18n} staleHours={staleHours} />
                        </span>
                        {p.collectionErrorCount > 0 && (
                          <a href={`${href(locale, 'dataQuality')}#${p.id}`} class="errors-link">
                            {i18n.f(d.common.errors, { count: p.collectionErrorCount })}
                          </a>
                        )}
                      </th>
                      {unsurveyed(p) ? (
                        <>
                          <td
                            class="sheet__cell sheet__cell--void sheet__overall"
                            id={`cell-${p.id}-overall`}
                            data-label={d.dimensions.overall}
                          >
                            <span class="sheet__plate">
                              <span class="sheet__cellhead">
                                <StatusBadge
                                  status="grey"
                                  i18n={i18n}
                                  context={d.dimensions.overall}
                                />
                                <span class="sheet__cellref" aria-hidden="true">
                                  A{row}
                                </span>
                              </span>
                              <span class="sheet__reason">{d.portfolio.notSurveyed}</span>
                            </span>
                          </td>
                          <td class="sheet__band" colspan={DIMS.length - 1}>
                            <div class="sheet__band-label">
                              <strong>{d.portfolio.notSurveyed}</strong>
                              <span>{why ?? d.portfolio.notSurveyedBody}</span>
                              <span class="sheet__counts">
                                {d.portfolio.openAlertsUnknown}:{' '}
                                <span class="nowrap">
                                  <Count
                                    value={p.openCounts.critical}
                                    partial={!p.countsComplete}
                                    i18n={i18n}
                                  />{' '}
                                  {d.portfolio.colCritical.toLowerCase()}
                                </span>{' '}
                                ·{' '}
                                <span class="nowrap">
                                  <Count
                                    value={p.openCounts.high}
                                    partial={!p.countsComplete}
                                    i18n={i18n}
                                  />{' '}
                                  {d.portfolio.colHigh.toLowerCase()}
                                </span>
                              </span>
                              <a href={`${href(locale, 'dataQuality')}#${p.id}`}>
                                {d.portfolio.reviewErrors}
                              </a>
                            </div>
                          </td>
                        </>
                      ) : (
                        DIMS.map((x) => {
                          const st = statusOf(p, x.key);
                          const h = health(s, x.key);
                          const r = h ? topReason(st, h.reasons) : undefined;
                          return (
                            <td
                              class:list={[
                                'sheet__cell',
                                `sheet__cell--${st}`,
                                x.key === 'overall' && 'sheet__overall',
                              ]}
                              id={`cell-${p.id}-${x.key}`}
                              data-label={d.dimensions[x.key]}
                            >
                              <span class="sheet__cellhead">
                                <StatusBadge
                                  status={st}
                                  i18n={i18n}
                                  context={d.dimensions[x.key]}
                                  size={x.key === 'overall' ? 'md' : 'sm'}
                                />
                                <span class="sheet__cellref" aria-hidden="true">
                                  {x.ref}
                                  {row}
                                </span>
                              </span>
                              {x.key === 'coverage' && (
                                <span class="sheet__metric">
                                  {p.coverage.percentage === null
                                    ? d.common.unknown
                                    : `${p.coverage.percentage}%`}{' '}
                                  ·{' '}
                                  <span
                                    title={i18n.f(d.securityPage.requiredCount, {
                                      available: p.coverage.available,
                                      required: p.coverage.required,
                                    })}
                                  >
                                    {p.coverage.available}/{p.coverage.required}
                                  </span>
                                </span>
                              )}
                              {x.key === 'security' && (
                                <span class="sheet__metric">
                                  <span class="nowrap">
                                    <Count
                                      value={p.openCounts.critical}
                                      partial={!p.countsComplete}
                                      i18n={i18n}
                                      emphasis="red"
                                    />{' '}
                                    {d.portfolio.colCritical.toLowerCase()}
                                  </span>{' '}
                                  ·{' '}
                                  <span class="nowrap">
                                    <Count
                                      value={p.openCounts.high}
                                      partial={!p.countsComplete}
                                      i18n={i18n}
                                      emphasis="amber"
                                    />{' '}
                                    {d.portfolio.colHigh.toLowerCase()}
                                  </span>
                                </span>
                              )}
                              {r && <span class="sheet__reason">{i18n.reason(r)}</span>}
                              {x.key === 'security' &&
                                p.secretScanning !== 'enabled' &&
                                p.secretScanning !== 'stale' && (
                                  <Pill
                                    tone={controlTone(p.secretScanning)}
                                    label={
                                      blind(p)
                                        ? d.portfolio.secretsBlind
                                        : `${d.control.secretScanning} — ${d.controlState[p.secretScanning]}`
                                    }
                                    title={`${d.control.secretScanning} — ${d.controlState[p.secretScanning]}`}
                                  />
                                )}
                            </td>
                          );
                        })
                      )}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <p class="sheet__bar sheet__foot">
            <span>{i18n.f(d.portfolio.gridKey, { count: projects.length })}</span>
            <span>
              {surveyedAt && i18n.f(d.portfolio.surveyedAt, { date: surveyedAt })}
              {index?.run.dataSource === 'mock' && ` · ${d.portfolio.synthetic}`}
            </span>
          </p>
          <p class="empty" hidden data-empty>
            {d.portfolio.noResults}
          </p>
        </section>

        <div class="sheet-margin">
          <section class="sheet-notes" aria-labelledby="notes-title">
            <h2 id="notes-title" class="sheet-head">
              {d.portfolio.notesTitle}
            </h2>
            {notes.length === 0 ? (
              <p class="sub">{d.portfolio.noNotes}</p>
            ) : (
              <ol class="sheet-notes__list">
                {notes.map((n) => (
                  <li class={`sheet-note sheet-note--${n.status}`}>
                    <a class="sheet-note__ref" href={`#cell-${n.p.id}-${n.cell}`}>
                      {n.ref}
                    </a>
                    <span>
                      <a href={href(locale, `projects/${n.p.id}`)}>{n.p.name}</a>
                      <span class="sub">{n.text ?? d.portfolio.openProject}</span>
                    </span>
                  </li>
                ))}
              </ol>
            )}
          </section>
          <Legend i18n={i18n} variant="sheet" />
        </div>
      </div>
    </>
  )}
</Base>

<script>
  import '../../scripts/portfolio-filters';
</script>
