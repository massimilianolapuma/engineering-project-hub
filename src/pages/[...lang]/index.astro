---
import type { Dimension, HealthResult, HealthStatus, ProjectSnapshot, Reason } from '@model/index';
import DimensionBars from '../../components/DimensionBars.astro';
import ErrorState from '../../components/ErrorState.astro';
import Legend from '../../components/Legend.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StatusDot from '../../components/StatusDot.astro';
import Base from '../../layouts/Base.astro';
import { healthRank } from '../../lib/format';
import { pageContext } from '../../lib/page';
import { href, localeParams } from '../../lib/routes';
import { scoreSortKey } from '../../lib/score';

export const getStaticPaths = localeParams;
const { locale } = Astro.props;
const { i18n, data, index, alternates } = pageContext(locale, 'portfolio');
const { d } = i18n;
const projects = data.ok ? data.data.index.projects : [];
type Project = (typeof projects)[number];
const snapshots = new Map<string, ProjectSnapshot>(
  data.ok ? data.data.projects.map((p) => [p.project.id, p]) : [],
);
const units = [...new Set(projects.map((p) => p.businessUnit))].sort();
const lifecycles = [...new Set(projects.map((p) => p.lifecycle))];
const tally = (s: HealthStatus) => projects.filter((p) => p.overall === s).length;
const needAttention = tally('red') + tally('amber');
/* Default order: score, worst first; "insufficient data" right after red; ties by name. */
const sorted = [...projects].sort(
  (a, b) => scoreSortKey(a.score) - scoreSortKey(b.score) || a.name.localeCompare(b.name),
);

const DIMS: Dimension[] = ['delivery', 'version', 'security', 'coverage', 'governance'];
const statusOf = (p: Project, k: Dimension): HealthStatus =>
  k === 'coverage' ? p.coverage.status : p[k];
const healthOf = (s: ProjectSnapshot | undefined, k: Dimension): HealthResult | undefined =>
  s &&
  {
    delivery: s.deliveryHealth,
    version: s.versionHealth,
    security: s.securityHealth,
    coverage: s.securityCoverage,
    governance: s.governanceHealth,
  }[k];
/** The reason that explains a dimension: one at the dimension's own level first. */
const topReason = (status: HealthStatus, reasons: Reason[]): Reason | undefined =>
  reasons.find((r) => r.level === status) ?? reasons.find((r) => r.level !== 'info') ?? reasons[0];
/** Nothing about this project could be measured: every dimension is unknown. */
const unmeasured = (p: Project) => DIMS.every((k) => statusOf(p, k) === 'grey');
/**
 * Main reason, one line: the top reason of each dimension at the project's worst level
 * (critical before attention), at most two, in dimension order.
 */
const mainReason = (p: Project): string | null => {
  const s = snapshots.get(p.id);
  const worst = Math.min(...DIMS.map((k) => healthRank(statusOf(p, k))));
  const sentences = DIMS.filter((k) => healthRank(statusOf(p, k)) === worst)
    .map((k) => healthOf(s, k))
    .map((h) => (h ? topReason(h.status, h.reasons) : undefined))
    .filter((r): r is Reason => r !== undefined)
    .map((r) => i18n.reason(r));
  const unique = [...new Set(sentences)].slice(0, 2);
  return unique.length ? unique.join(' · ') : null;
};
/** Repository names, so the search also finds a project by one of its repositories. */
const searchText = (p: Project) => {
  const s = snapshots.get(p.id);
  const repos = s
    ? [s.coordinator.repository.fullName, ...s.components.map((c) => c.repository.fullName)]
    : [];
  return [p.name, ...new Set(repos)].join(' ').toLowerCase();
};
const collectedAt = index ? i18n.date(index.generatedAt) : null;
---

<Base
  i18n={i18n}
  title={d.portfolio.title}
  page="portfolio"
  alternates={alternates}
  index={index}
  legend={false}
>
  {!data.ok ? (
    <ErrorState error={data.error} i18n={i18n} />
  ) : (
    <div class="portfolio">
      <header class="portfolio__head">
        <div>
          <h1>{d.portfolio.title}</h1>
          <p class="portfolio__lead">
            {i18n.f(d.portfolio.lead, { n: needAttention, total: projects.length })}
          </p>
        </div>
        <div class="counts" role="group" aria-label={d.portfolio.countsLabel}>
          {(['red', 'amber', 'green', 'grey'] as const).map((s) => (
            <button type="button" class="count-btn" data-health-filter={s} aria-pressed="false">
              <span class={`count-btn__dot count-btn__dot--${s}`} aria-hidden="true" />
              <span class="count-btn__value">{tally(s)}</span>
              <span>{i18n.status(s)}</span>
            </button>
          ))}
        </div>
      </header>

      <form class="portfolio__filters" data-portfolio-filters role="search">
        {/*
          Desktop: one inline row (the summary is hidden and the box stays open). Phones: one
          "Filters" disclosure, closed unless a filter comes from the URL, so the list starts
          higher. Open in the HTML so the fields show before the script runs on desktop.
        */}
        <details class="portfolio__filterbox disclosure" data-filterbox open>
          <summary>{d.portfolio.filters}</summary>
          <div class="portfolio__filterbody">
            <div class="field field--grow">
              <label for="f-q">{d.portfolio.search}</label>
              <input
                id="f-q"
                name="q"
                type="search"
                placeholder={d.portfolio.searchPlaceholder}
                autocomplete="off"
              />
            </div>
            <div class="field">
              <label for="f-health">{d.portfolio.filterHealth}</label>
              <select id="f-health" name="health">
                <option value="">{d.portfolio.all}</option>
                {(['red', 'amber', 'green', 'grey'] as const).map((s) => (
                  <option value={s}>{i18n.status(s)}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="f-bu">{d.portfolio.filterBu}</label>
              <select id="f-bu" name="bu">
                <option value="">{d.portfolio.all}</option>
                {units.map((u) => (
                  <option value={u}>{u}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="f-sort">{d.portfolio.sort}</label>
              <select id="f-sort" name="sort">
                <option value="score" selected>
                  {d.portfolio.sortScore}
                </option>
                <option value="health">{d.portfolio.sortHealth}</option>
                <option value="name">{d.portfolio.sortName}</option>
                <option value="updated">{d.portfolio.sortUpdated}</option>
                <option value="critical">{d.portfolio.sortCritical}</option>
              </select>
            </div>
            <details class="portfolio__more disclosure" data-more-filters>
              <summary>{d.portfolio.moreFilters}</summary>
              <div class="portfolio__more-body">
                <div class="field">
                  <label for="f-lc">{d.portfolio.filterLifecycle}</label>
                  <select id="f-lc" name="lifecycle">
                    <option value="">{d.portfolio.all}</option>
                    {lifecycles.map((l) => (
                      <option value={l}>{d.lifecycle[l]}</option>
                    ))}
                  </select>
                </div>
                <div class="field">
                  <label for="f-sev">{d.portfolio.filterSeverity}</label>
                  <select id="f-sev" name="severity">
                    <option value="">{d.portfolio.all}</option>
                    <option value="critical">{d.portfolio.filterSeverityCritical}</option>
                    <option value="high">{d.portfolio.filterSeverityHigh}</option>
                  </select>
                </div>
              </div>
            </details>
          </div>
        </details>
        <p
          class="portfolio__results"
          aria-live="polite"
          data-results
          data-template={d.portfolio.results}
          data-unknown-one={d.portfolio.unknownHidden.one}
          data-unknown-other={d.portfolio.unknownHidden.other}
        >
          {i18n.f(d.portfolio.results, { shown: projects.length, total: projects.length })}
        </p>
        <button type="button" class="btn btn--ghost portfolio__clear" data-clear-filters hidden>
          {d.portfolio.clearFilters}
        </button>
      </form>

      <div class="plist">
        <table role="table" class="plist__table" data-portfolio-table>
          <caption class="visually-hidden">
            {d.portfolio.tableCaption}. {d.portfolio.scoreHelp}
          </caption>
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col" class="plist__c-dot">
                <span class="visually-hidden">{d.portfolio.statusColumn}</span>
              </th>
              <th role="columnheader" scope="col">
                {d.portfolio.colProject}
              </th>
              <th
                role="columnheader"
                scope="col"
                class="plist__c-score"
                title={d.portfolio.scoreHelp}
              >
                {d.portfolio.scoreColumn}
              </th>
              <th role="columnheader" scope="col" class="plist__c-dims">
                <span class="visually-hidden">{d.portfolio.dimensionsColumn}</span>
                <DimensionBars variant="header" locale={locale} />
              </th>
              <th role="columnheader" scope="col">
                {d.portfolio.reasonColumn}
              </th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {sorted.map((p) => {
              const none = unmeasured(p);
              const reason = mainReason(p);
              return (
                <tr
                  role="row"
                  data-project
                  data-name={p.name.toLowerCase()}
                  data-search={searchText(p)}
                  data-health={p.overall}
                  data-rank={healthRank(p.overall)}
                  data-score={p.score.value ?? ''}
                  data-bu={p.businessUnit}
                  data-lifecycle={p.lifecycle}
                  data-critical={p.openCounts.critical ?? -1}
                  data-high={p.openCounts.high ?? -1}
                  data-updated={p.collectedAt}
                >
                  <td role="cell" class="plist__dot">
                    <StatusDot
                      status={p.overall}
                      label={`${d.dimensions.overall}: ${i18n.status(p.overall)}`}
                    />
                  </td>
                  <th role="rowheader" scope="row" class="plist__name">
                    <a class="plist__link" href={href(locale, `projects/${p.id}`)}>
                      {p.name}
                    </a>
                    <span class="plist__bu">{p.businessUnit}</span>
                  </th>
                  <td role="cell" class="plist__score">
                    <ScoreBadge score={p.score} locale={locale} />
                  </td>
                  <td role="cell" class="plist__dims">
                    {/* Phone and tablet: the header row is hidden, so label the bars here. */}
                    <span class="plist__dimlabels" aria-hidden="true">
                      <DimensionBars variant="header" locale={locale} />
                    </span>
                    <DimensionBars
                      dims={DIMS.map((k) => ({ dimension: k, status: statusOf(p, k) }))}
                      locale={locale}
                    />
                  </td>
                  <td role="cell" class="plist__reason">
                    <div class="plist__why">
                      <span class="status-col">
                        <StatusBadge
                          status={p.overall}
                          i18n={i18n}
                          context={d.dimensions.overall}
                          size="sm"
                        />
                      </span>
                      {none && p.collectionErrorCount > 0 ? (
                        <span>
                          {d.portfolio.noData}{' '}
                          <a
                            href={`${href(locale, 'dataQuality')}#${p.id}`}
                            title={d.portfolio.reviewErrors}
                          >
                            {i18n.errors(p.collectionErrorCount)}
                          </a>
                        </span>
                      ) : (
                        <span>
                          {reason ?? d.common.unknown}
                          {p.collectionErrorCount > 0 && (
                            <>
                              {' · '}
                              <a
                                href={`${href(locale, 'dataQuality')}#${p.id}`}
                                title={d.portfolio.reviewErrors}
                              >
                                {i18n.errors(p.collectionErrorCount)}
                              </a>
                            </>
                          )}
                        </span>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div class="plist__empty" hidden data-empty>
          <p>{d.portfolio.noResults}</p>
          <button type="button" class="btn" data-clear-filters>
            {d.portfolio.clearFilters}
          </button>
        </div>
      </div>

      <Legend i18n={i18n} />

      <p class="portfolio__foot">
        {collectedAt && <span>{i18n.f(d.portfolio.collectedAt, { date: collectedAt })}</span>}
        {index?.run.dataSource === 'mock' && <span>{d.portfolio.synthetic}</span>}
      </p>
    </div>
  )}
</Base>

<script>
  import '../../scripts/portfolio-filters';
</script>

<style>
  .portfolio {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .portfolio__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .portfolio__head h1 {
    margin: 0;
  }
  .portfolio__lead {
    margin: 6px 0 0;
    font-size: var(--fs-lead);
    line-height: 24px;
    font-weight: 600;
  }

  /* Status counts: shortcuts for the status filter; pressing the active one clears it. */
  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .count-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .count-btn:hover {
    border-color: var(--border-strong);
  }
  .count-btn[aria-pressed='true'] {
    border-color: var(--text);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--text);
  }
  .count-btn__value {
    font-size: var(--fs-count);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .count-btn__dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .count-btn__dot--red {
    background: var(--red);
  }
  .count-btn__dot--amber {
    background: var(--amber);
  }
  .count-btn__dot--green {
    background: var(--green);
  }
  .count-btn__dot--grey {
    border: 2px dashed var(--unknown);
  }

  /* Filters: one inline row; lifecycle and severity under "More filters". */
  .portfolio__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
  }
  .portfolio__filterbox {
    flex: 1 1 auto;
    min-width: 0;
  }
  .portfolio__filterbox > summary {
    display: none;
  }
  .portfolio__filterbody {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
  }
  .portfolio__more {
    align-self: flex-end;
    font-size: var(--fs-sm);
  }
  .portfolio__more > summary {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text);
    font-weight: 500;
  }
  .portfolio__more[open] {
    flex-basis: 100%;
  }
  .portfolio__more-body {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .portfolio__results {
    margin: 0 0 0 auto;
    align-self: center;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  .portfolio__clear {
    align-self: center;
  }
  .portfolio__clear[hidden] {
    display: none;
  }

  /* The list: one row per project, worst first. */
  .plist {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
  }
  .plist__table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .plist__table thead th {
    padding: 10px var(--space-4);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-align: left;
    white-space: nowrap;
  }
  .plist__table td,
  .plist__table tbody th {
    padding: 14px var(--space-4);
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: middle;
  }
  .plist__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .plist__table tbody tr:hover {
    background: var(--surface-2);
  }
  .plist__c-dot {
    width: 44px;
  }
  .plist__c-score {
    width: 150px;
  }
  .plist__c-dims {
    width: 212px;
  }
  .plist__name {
    min-width: 160px;
    font-weight: 400;
  }
  .plist__link {
    display: inline-block;
    font-size: var(--fs-card);
    font-weight: 600;
  }
  .plist__bu {
    display: block;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }
  /* Pill in a fixed-width column so every reason sentence starts at the same x. */
  .plist__why {
    display: grid;
    grid-template-columns: var(--status-col) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-3);
    min-width: 240px;
  }
  .plist__empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4);
    color: var(--text-muted);
  }
  .plist__empty[hidden] {
    display: none;
  }
  .plist__empty p {
    margin: 0;
  }
  .plist__dimlabels {
    display: none;
  }

  .portfolio__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  /*
   * Phone and tablet: each row wraps — status, name and score on line one, the dimension
   * bars (with their short labels) then the reason below. No horizontal scroll, and the
   * reason, the most important text, always wraps inside the viewport.
   */
  @media (max-width: 1000px) {
    .plist {
      overflow-x: visible;
    }
    .plist__table,
    .plist__table tbody {
      display: block;
    }
    .plist__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .plist__table tbody tr {
      display: grid;
      grid-template-columns: 18px minmax(0, 1fr) auto;
      grid-template-areas:
        'dot name score'
        'dims dims dims'
        'reason reason reason';
      align-items: center;
      gap: var(--space-2) var(--space-3);
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--border);
    }
    .plist__table tbody tr:last-child {
      border-bottom: 0;
    }
    .plist__table tbody tr[hidden] {
      display: none;
    }
    .plist__table td,
    .plist__table tbody th {
      padding: 0;
      border: 0;
    }
    .plist__dot {
      grid-area: dot;
    }
    .plist__name {
      grid-area: name;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .plist__score {
      grid-area: score;
      max-width: 10rem;
    }
    .plist__score :global(.score) {
      align-items: flex-end;
      text-align: right;
    }
    .plist__score :global(.score__conf) {
      text-wrap: balance;
    }
    .plist__dims {
      grid-area: dims;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .plist__dimlabels {
      display: block;
    }
    .plist__reason {
      grid-area: reason;
      min-width: 0;
    }
    .plist__why {
      min-width: 0;
    }
    .portfolio__results {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  /*
   * Phones: the filter fields fold into one "Filters" disclosure (closed unless a filter is
   * set), with the results line beside it, so the first project shows sooner.
   */
  @media (max-width: 720px) {
    .portfolio__filters {
      align-items: center;
    }
    .portfolio__filterbox {
      flex: 0 0 auto;
    }
    .portfolio__filterbox[open] {
      flex-basis: 100%;
    }
    .portfolio__filterbox > summary {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      background: var(--surface);
      color: var(--text);
      font-size: var(--fs-sm);
      font-weight: 500;
      cursor: pointer;
    }
    .portfolio__filterbody {
      margin-top: var(--space-3);
    }
    .portfolio__results {
      flex: 1 1 12rem;
    }
  }

  /* Narrow phones: the pill goes on its own line above the reason, left-aligned. */
  @media (max-width: 480px) {
    .plist__why {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      row-gap: var(--space-1);
    }
  }
</style>
