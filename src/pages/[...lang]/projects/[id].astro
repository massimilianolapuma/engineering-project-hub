---
/**
 * Project page: one question first ("why is it in this state?"), then the six dimensions,
 * the environments path and the components; everything else is collapsed on demand.
 */
import {
  countsAsOpen,
  type ComponentSnapshot,
  type Dimension,
  type HealthResult,
  type HealthStatus,
  type Reason,
  type SeverityCounts,
  type WorkflowStatus,
} from '@model/index';
import ControlSymbol from '../../../components/ControlSymbol.astro';
import ErrorsTable from '../../../components/ErrorsTable.astro';
import ExtLink from '../../../components/ExtLink.astro';
import Legend from '../../../components/Legend.astro';
import Pill from '../../../components/Pill.astro';
import QualitySection from '../../../components/QualitySection.astro';
import RepositoryControlsSection from '../../../components/RepositoryControlsSection.astro';
import RelTime from '../../../components/RelTime.astro';
import RiskPanel from '../../../components/RiskPanel.astro';
import ScoreBadge from '../../../components/ScoreBadge.astro';
import SlaMeta from '../../../components/SlaMeta.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import TrendSection from '../../../components/TrendSection.astro';
import UnknownValue from '../../../components/UnknownValue.astro';
import Base from '../../../layouts/Base.astro';
import { loadHistory, loadSiteData } from '../../../lib/data';
import { displayVersion } from '../../../lib/format';
import { pageContext } from '../../../lib/page';
import { loadSitePolicies } from '../../../lib/policies';
import { href, localeParams } from '../../../lib/routes';
import { driftTone, severityTone, workflowTone, type Tone } from '../../../lib/tones';

export function getStaticPaths() {
  const data = loadSiteData();
  if (!data.ok) return [];
  return localeParams().flatMap((l) =>
    data.data.projects.map((p) => ({
      params: { lang: l.params.lang, id: p.project.id },
      props: { locale: l.props.locale, id: p.project.id },
    })),
  );
}
const { locale, id } = Astro.props;
const { i18n, data, index, alternates } = pageContext(locale, `projects/${id}`);
const { d, f } = i18n;
const s = data.ok ? (data.data.projects.find((p) => p.project.id === id) ?? null) : null;
const staleHours = index?.run.policy.snapshotStaleHours ?? 24;
/** Quality thresholds for the meter tick and the legend (as on "How to read"). */
const qualityPolicy = loadSitePolicies().policies.quality;

const LEVEL_RANK: Record<Reason['level'], number> = { red: 0, amber: 1, grey: 2, info: 3 };
const WHY_LIMIT = 5;
const lower = (t: string) => t.toLocaleLowerCase(locale);

/** The six dimensions, each with the section its card links to. */
const dims: { dim: Dimension; anchor: string; health: HealthResult }[] = s
  ? [
      { dim: 'delivery', anchor: 'workflows', health: s.deliveryHealth },
      { dim: 'version', anchor: 'environments', health: s.versionHealth },
      { dim: 'security', anchor: 'security', health: s.securityHealth },
      { dim: 'coverage', anchor: 'coverage', health: s.securityCoverage },
      // Governance checks repository standards: the repository controls section leads, and
      // ends with a link to the standard workflows.
      { dim: 'governance', anchor: 'repository-controls', health: s.governanceHealth },
      { dim: 'quality', anchor: 'quality', health: s.qualityHealth },
    ]
  : [];

/** Run linked from a workflow reason (same repository and run number), if any. */
const runUrl = (r: Reason): string | null => {
  if (!s || typeof r.params.repository !== 'string' || !r.params.run) return null;
  const w = s.workflows.find(
    (x) =>
      x.repository === r.params.repository &&
      (x.lastCompletedRun?.runNumber === Number(r.params.run) ||
        x.latestRun?.runNumber === Number(r.params.run)),
  );
  return w?.lastCompletedRun?.url ?? w?.latestRun?.url ?? null;
};

/** "Why it is …": every non-info reason of the dimensions, red first, then amber, then grey. */
type Issue = { dim: Dimension; anchor: string; r: Reason };
const issues: Issue[] = dims
  .flatMap(({ dim, anchor, health }) =>
    health.reasons.filter((r) => r.level !== 'info').map((r) => ({ dim, anchor, r })),
  )
  .sort((a, b) => LEVEL_RANK[a.r.level] - LEVEL_RANK[b.r.level]);
const errorClasses = s
  ? [...new Set(s.collectionErrors.map((e) => d.errorClass[e.classification]))]
  : [];
const showCause =
  !!s &&
  s.collectionErrors.length > 0 &&
  (s.overallHealth.status === 'grey' || s.score.value === null);
/**
 * Nothing could be measured (e.g. a project whose repositories could not be read): the cause
 * leads, and the identical "Unknown" rows fold into one line; the reasons stay one click away.
 */
const allUnknown = showCause && dims.every(({ health }) => health.status === 'grey');
const whyShown = allUnknown ? [] : issues.slice(0, WHY_LIMIT);
const whyHidden = issues.slice(whyShown.length);

/** One-line summary on a dimension card. */
const topReason = (h: HealthResult) =>
  [...h.reasons].sort((a, b) => LEVEL_RANK[a.level] - LEVEL_RANK[b.level])[0];
const sum = (c: SeverityCounts | null, keys: (keyof SeverityCounts)[]) =>
  keys.reduce((n, k) => n + (c?.[k] ?? 0), 0);
/** One vocabulary for severity counts on the card, the components table and the security section. */
const sevCount = (k: keyof SeverityCounts, n: number) =>
  `${n} ${n === 1 ? d.project.sevOne[k] : d.project.sevMany[k]}`;
const OTHER_SEVERITIES: (keyof SeverityCounts)[] = ['medium', 'low', 'informational', 'unknown'];
const otherCount = (n: number) => f(n === 1 ? d.project.otherOne : d.project.otherMany, { n });
/**
 * Coverage line that never shows unknown as zero: controls that could not be read are named
 * ("n not visible"), and lead the line when nothing at all could be confirmed as enabled.
 */
function coverageLine(template: string): string {
  if (!s) return '';
  const cov = s.securityCoverage;
  const blind = cov.notAuthorised + cov.unknown;
  const base = f(template, { available: cov.available, required: cov.required });
  if (blind === 0) return base;
  const blindText = f(blind === 1 ? d.project.dimBlindOne : d.project.dimBlind, { n: blind });
  return cov.available === 0 ? `${blindText} · ${base}` : `${base} · ${blindText}`;
}
function dimSummary(dim: Dimension, health: HealthResult): string {
  if (!s) return '';
  if (dim === 'security') {
    const c = s.securityHealth.openCounts;
    if (c.critical === null) return d.project.dimSecurityUnknown;
    const counts = f(d.project.dimSecurity, {
      critical: sevCount('critical', c.critical ?? 0),
      high: sevCount('high', c.high ?? 0),
      other: otherCount(sum(c, OTHER_SEVERITIES)),
    });
    // Some sources unreadable: the counts are a lower bound, say so on the card too.
    const base = s.securityHealth.countsComplete
      ? counts
      : `${counts} · ${d.project.alertsPartial}`;
    const overdue = Object.values(s.securityHealth.remediation.overdue).reduce<number>(
      (n, v) => n + (v ?? 0),
      0,
    );
    const accepted = Object.values(s.securityHealth.acceptedCounts).reduce<number>(
      (n, v) => n + (v ?? 0),
      0,
    );
    return overdue + accepted > 0 ? `${base} · ${f(d.risk.cardLine, { overdue, accepted })}` : base;
  }
  if (dim === 'coverage' && s.securityCoverage.required > 0) {
    return coverageLine(d.project.dimCoverage);
  }
  // Nothing measured: the top reason says why (not visible or not applicable), never 0%.
  if (dim === 'quality' && s.qualityHealth.percentage !== null) {
    return f(d.project.quality.cardLine, {
      pct: i18n.pctNumber(s.qualityHealth.percentage),
      threshold: i18n.pctNumber(qualityPolicy.greenThresholdPercent),
    });
  }
  const r = topReason(health);
  const text = r ? i18n.reason(r) : d.common.unknownValue;
  const rc = s.repositoryControls;
  if (dim === 'governance' && rc.enabled && rc.passed + rc.failed > 0)
    return `${text} · ${f(d.project.repoControls.dimLine, { passed: rc.passed, applicable: rc.passed + rc.failed })}`;
  return text;
}

/** Workflow state as shown: a successful but stale run is "Stale", not "Success". */
const WF_RANK: Record<string, number> = {
  failure: 0,
  cancelled: 0,
  missing: 1,
  'never-run': 1,
  stale: 2,
  'not-authorised': 3,
  unknown: 3,
  'in-progress': 4,
  queued: 4,
  success: 5,
};
const wfView = (w: WorkflowStatus): { key: string; tone: Tone; label: string } =>
  w.stale && w.state === 'success'
    ? { key: 'stale', tone: 'amber', label: d.common.stale }
    : { key: w.state, tone: workflowTone(w.state), label: d.workflowState[w.state] };
const workflows = s
  ? [...s.workflows].sort(
      (a, b) =>
        WF_RANK[wfView(a).key]! - WF_RANK[wfView(b).key]! ||
        Number(b.critical) - Number(a.critical),
    )
  : [];
const wfHint = (() => {
  const counts = new Map<string, { n: number; label: string }>();
  for (const w of workflows) {
    const v = wfView(w);
    const c = counts.get(v.key) ?? { n: 0, label: v.label };
    c.n += 1;
    counts.set(v.key, c);
  }
  return [...counts.entries()]
    .map(([key, { n, label }]) =>
      key === 'success'
        ? f(d.project.wfOk, { n })
        : f(d.project.wfCount, { n, state: lower(label) }),
    )
    .join(' · ');
})();

const nameOf = (componentId: string) =>
  componentId === 'coordinator'
    ? d.common.coordinator
    : (s?.components.find((c) => c.id === componentId)?.name ?? componentId);

/**
 * Components table: worst critical workflow, open alerts and required controls per component.
 * A component that lives in the coordinator repository (monorepo) has no entries of its own:
 * its workflows and controls are the shared repository's, recorded under the coordinator.
 */
const sameRepo = (a: string, b: string) => a.toLowerCase() === b.toLowerCase();
const sharesCoordinatorRepo = (c: ComponentSnapshot) =>
  !!s && sameRepo(c.repository.fullName, s.coordinator.repository.fullName);
const ofComponent = <T extends { componentId: string; repository: string }>(
  items: T[],
  c: ComponentSnapshot,
): { items: T[]; shared: boolean } => {
  const own = items.filter((x) => x.componentId === c.id);
  if (own.length > 0 || !sharesCoordinatorRepo(c)) return { items: own, shared: false };
  const shared = items.filter(
    (x) => x.componentId === 'coordinator' && sameRepo(x.repository, c.repository.fullName),
  );
  return { items: shared, shared: shared.length > 0 };
};
const ciOf = (c: ComponentSnapshot) => {
  const crit = ofComponent(workflows, c).items.filter((w) => w.critical);
  return crit.length ? wfView(crit[0]!) : null;
};
const SEVERITIES = ['critical', 'high', 'medium', 'low', 'informational', 'unknown'] as const;
const BLIND = new Set(['not-authorised', 'unknown', 'collection-failed']);
const controlsEntry = (c: ComponentSnapshot) => ofComponent(s?.securityControls ?? [], c);
const controlsOf = (c: ComponentSnapshot) => controlsEntry(c).items[0]?.controls ?? [];
const sharedControls = (c: ComponentSnapshot) => controlsEntry(c).shared;
function alertsOf(c: ComponentSnapshot): { text: string | null; partial: boolean } {
  const controls = controlsOf(c);
  const read = controls.filter((x) => x.counts !== null);
  const partial = controls.some((x) => x.required && BLIND.has(x.state));
  if (read.length === 0) return { text: null, partial };
  const parts = SEVERITIES.map((k) => ({
    k,
    n: read.reduce((t, x) => t + (x.counts?.[k] ?? 0), 0),
  }))
    .filter((x) => x.n > 0)
    .map((x) => sevCount(x.k, x.n));
  return { text: parts.length ? parts.join(' · ') : d.common.noOpenAlerts, partial };
}
const gapsOf = (c: ComponentSnapshot) =>
  controlsOf(c).filter((x) => x.required && x.state !== 'enabled');
const hasRequired = (c: ComponentSnapshot) => controlsOf(c).some((x) => x.required);

/**
 * Security: counted critical and high alerts are listed; everything else is a count + GitHub.
 * An alert accepted by an exception stays "open" on GitHub but is listed apart (RiskPanel), so
 * it never hides an external alert in the "unlisted" subtraction below.
 */
const listed = s
  ? s.securityFindings.filter(
      (x) => countsAsOpen(x) && (x.severity === 'critical' || x.severity === 'high'),
    )
  : [];
const openCounts = s?.securityHealth.openCounts;
const countsKnown = openCounts ? openCounts.critical !== null : false;
/**
 * Open critical/high alerts the hub has no finding record for (e.g. container scanning): they
 * stay critical/high, named by severity, never folded into "other". Same split as the card.
 */
const unlisted = (['critical', 'high'] as const)
  .map((k) => ({
    k,
    n: Math.max(0, (openCounts?.[k] ?? 0) - listed.filter((x) => x.severity === k).length),
  }))
  .filter((x) => x.n > 0);
const unlistedText = unlisted.map((x) => sevCount(x.k, x.n)).join(' · ');
const otherAlerts = openCounts ? sum(openCounts, OTHER_SEVERITIES) : 0;
/** Monorepo: the shared repository's alerts are shown once, under the components table. */
const sharedAlertsComponent = s?.components.find((c) => sharedControls(c)) ?? null;
const sharedAlerts = sharedAlertsComponent ? alertsOf(sharedAlertsComponent) : null;
const repos = s
  ? [s.coordinator.repository, ...s.components.map((c) => c.repository)].filter(
      (r, i, all) => r.status === 'ok' && all.findIndex((x) => x.fullName === r.fullName) === i,
    )
  : [];

const coordRepo = s?.coordinator.repository;
const kindLabel = !s
  ? ''
  : s.components.length === 0
    ? d.project.kindSingle
    : s.components.every(
          (c) => c.repository.fullName.toLowerCase() === coordRepo?.fullName.toLowerCase(),
        )
      ? d.project.kindMonorepo
      : d.project.kindMulti;
const statusOf = (h: HealthResult): HealthStatus => h.status;
/** Why-box reasons are never info (filtered above); info would read as healthy. */
const levelStatus = (r: Reason): HealthStatus => (r.level === 'info' ? 'green' : r.level);
---

<Base i18n={i18n} title={s?.project.name ?? id} page={null} alternates={alternates} index={index}>
  {s && coordRepo && (
    <>
      <nav class="crumbs" aria-label={d.project.breadcrumb}>
        <a href={href(locale, 'portfolio')}>{d.nav.portfolio}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{s.project.name}</span>
      </nav>

      <header class="phead">
        <div class="phead__main">
          <div class="phead__title">
            <h1>{s.project.name}</h1>
            <StatusBadge
              status={s.overallHealth.status}
              i18n={i18n}
              context={d.dimensions.overall}
            />
          </div>
          <p class="phead__meta">
            {s.project.businessUnit} · {d.lifecycle[s.project.lifecycle]} · {kindLabel} ·{' '}
            {d.common.coordinator}{' '}
            <ExtLink href={coordRepo.url} i18n={i18n}>
              <code>{coordRepo.name}</code>
            </ExtLink>
          </p>
          <p class="phead__desc">{s.project.description}</p>
        </div>
        <div class="phead__score">
          <ScoreBadge score={s.score} locale={locale} size="header" />
          <p class="phead__collected">
            {d.project.collected}{' '}
            <RelTime iso={s.generatedAt} i18n={i18n} staleHours={staleHours} />
          </p>
        </div>
      </header>

      <section class="card why" aria-labelledby="h-why">
        <h2 id="h-why">{d.project.whyTitle[s.overallHealth.status]}</h2>
        {(() => {
          const item = ({ dim, anchor, r }: Issue) => {
            const run = runUrl(r);
            return (
              <li class="why__item" data-level={r.level}>
                <span class="status-col">
                  <Pill tone={levelStatus(r)} label={i18n.status(levelStatus(r))} />
                </span>
                <span class="why__text">
                  {i18n.reason(r)}.{' '}
                  {run ? (
                    <ExtLink href={run} i18n={i18n} label={d.project.openRun} />
                  ) : (
                    <a href={`#${anchor}`}>
                      {d.project.seeSection}
                      <span class="visually-hidden">: {i18n.dimension(dim)}</span>
                    </a>
                  )}
                </span>
              </li>
            );
          };
          const cause = showCause && (
            <p class="why__cause" data-why-cause>
              {f(s.collectionErrors.length === 1 ? d.project.whyCauseOne : d.project.whyCause, {
                count: s.collectionErrors.length,
                classes: errorClasses.join(', '),
              })}{' '}
              <a href={href(locale, 'dataQuality')}>{d.project.seeDataQuality}</a>
            </p>
          );
          return (
            <>
              {allUnknown && cause}
              <ul class="why__list">
                {allUnknown ? (
                  <li class="why__item" data-level="grey" data-all-unknown>
                    <span class="status-col">
                      <Pill tone="grey" label={i18n.status('grey')} />
                    </span>
                    <span class="why__text">{f(d.project.allUnknown, { n: dims.length })}</span>
                  </li>
                ) : whyShown.length > 0 ? (
                  whyShown.map(item)
                ) : (
                  s.overallHealth.reasons.map((r) => (
                    <li class="why__item" data-level={r.level}>
                      <span class="why__text">{i18n.reason(r)}</span>
                    </li>
                  ))
                )}
              </ul>
              {whyHidden.length > 0 && (
                <details class="why__more disclosure" data-why-more>
                  <summary>
                    {whyHidden.length === 1
                      ? d.project.whyMoreOne
                      : f(d.project.whyMore, { n: whyHidden.length })}
                  </summary>
                  <ul class="why__list">{whyHidden.map(item)}</ul>
                </details>
              )}
              {!allUnknown && cause}
            </>
          );
        })()}
      </section>

      <section class="dimcards" aria-label={d.project.dimensionCards}>
        {dims.map(({ dim, anchor, health }) => (
          <a
            class="card dimcard"
            href={`#${anchor}`}
            data-dimension={dim}
            data-status={statusOf(health)}
          >
            <span class="dimcard__head">
              <span class={`dimcard__dot dimcard__dot--${statusOf(health)}`} aria-hidden="true" />
              <strong class="dimcard__name">{i18n.dimension(dim)}</strong>
            </span>
            <span class="dimcard__pill">
              <Pill tone={statusOf(health)} label={i18n.status(statusOf(health))} />
            </span>
            <span class="dimcard__summary">{dimSummary(dim, health)}</span>
          </a>
        ))}
      </section>

      <TrendSection projectId={s.project.id} history={loadHistory()} locale={locale} />

      <section id="environments" class="block" aria-labelledby="h-env">
        <h2 id="h-env">{d.project.environments}</h2>
        <p class="coordline">
          {d.project.coordinatorVersion}{' '}
          {s.coordinator.version ? (
            <>
              <strong class="mono">{displayVersion(s.coordinator.version)}</strong>{' '}
              {f(d.project.versionFrom, { source: d.versionSource[s.coordinator.versionSource] })}
            </>
          ) : (
            <strong>{d.project.versionUnknown}</strong>
          )}
          {s.coordinator.latestRelease && (
            <>
              {' · '}
              {d.project.latestRelease}{' '}
              <ExtLink
                href={s.coordinator.latestRelease.url}
                i18n={i18n}
                label={s.coordinator.latestRelease.tag}
              />
            </>
          )}
          {' · '}
          {d.project.manifest} <code>{s.coordinator.manifest.path}</code>{' '}
          {lower(d.manifestStatus[s.coordinator.manifest.status])}
        </p>
        {s.environments.length === 0 ? (
          <p class="muted">{d.project.noEnvironments}</p>
        ) : (
          <ol class="envpath" aria-label={d.project.environmentsPath}>
            {s.environments.map((e, i) => (
              <li class="envpath__step" data-env={e.name} data-env-status={e.status}>
                {i > 0 && (
                  <span class="envpath__arrow" aria-hidden="true">
                    →
                  </span>
                )}
                <span class={`envpath__card envpath__card--${e.status}`}>
                  <strong>{e.name}</strong>
                  <span class="mono">{displayVersion(e.version) ?? d.common.unknown}</span>
                  <Pill tone={driftTone(e.status)} label={d.envStatus[e.status]} />
                  {(e.status === 'behind' || e.status === 'mismatch') && s.coordinator.version && (
                    <span class="envpath__expected">
                      {f(d.project.envExpected, {
                        version: displayVersion(s.coordinator.version)!,
                      })}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ol>
        )}
        <p class="note">{d.project.envBehindNote}</p>
      </section>

      <section class="block" aria-labelledby="h-components">
        <h2 id="h-components">{d.project.components}</h2>
        {s.components.length === 0 ? (
          <p class="muted">{d.project.noComponents}</p>
        ) : (
          <div class="table-wrap">
            <table role="table" class="table comps">
              <caption class="visually-hidden">{d.project.componentsCaption}</caption>
              <thead role="rowgroup">
                <tr role="row">
                  <th role="columnheader" scope="col">
                    {d.common.component}
                  </th>
                  <th role="columnheader" scope="col">
                    {d.common.version}
                  </th>
                  <th role="columnheader" scope="col">
                    {d.project.ci}
                  </th>
                  <th role="columnheader" scope="col">
                    {d.project.openAlerts}
                  </th>
                  <th role="columnheader" scope="col">
                    {d.project.coverageCol}
                  </th>
                </tr>
              </thead>
              <tbody role="rowgroup">
                {s.components.map((c) => {
                  const eff = displayVersion(c.effectiveVersion);
                  const latest = c.latestRelease;
                  const ci = ciOf(c);
                  const alerts = alertsOf(c);
                  const gaps = gapsOf(c);
                  return (
                    <tr role="row" data-component={c.id}>
                      <th role="rowheader" scope="row">
                        <span class="comps__name">{c.name}</span>{' '}
                        <span class="sub">{d.componentType[c.type]}</span>
                        <span class="comps__repo">
                          {c.repository.status === 'ok' ? (
                            <ExtLink href={c.repository.url} i18n={i18n}>
                              <code>{c.repository.name}</code>
                            </ExtLink>
                          ) : (
                            <>
                              <code>{c.repository.name}</code>{' '}
                              <Pill
                                tone="grey"
                                label={
                                  c.repository.status === 'not-authorised'
                                    ? d.common.notAuthorised
                                    : d.common.collectionFailed
                                }
                              />
                            </>
                          )}
                        </span>
                      </th>
                      <td role="cell" data-label={d.common.version}>
                        <span class="cell">
                          {eff ? (
                            <span class="mono">{eff}</span>
                          ) : (
                            <span class="muted">{d.common.unknown}</span>
                          )}
                          {latest && c.drift === 'drift' && (
                            <span class="muted">
                              {' → '}
                              <ExtLink
                                href={latest.url}
                                i18n={i18n}
                                label={f(d.project.latest, {
                                  version: displayVersion(latest.tag)!,
                                })}
                              />
                            </span>
                          )}
                          {c.manifestConsistency === 'mismatch' && (
                            <span class="comps__flag">
                              <Pill tone="amber" label={d.consistency.mismatch} />
                              <span class="sub">
                                {lower(d.project.declared)}{' '}
                                <span class="mono">
                                  {displayVersion(c.declaredVersion) ?? d.common.unknownValue}
                                </span>
                              </span>
                            </span>
                          )}
                        </span>
                      </td>
                      <td role="cell" data-label={d.project.ci}>
                        {ci ? (
                          <Pill tone={ci.tone} label={ci.label} />
                        ) : (
                          <span class="muted">{d.project.noCriticalWorkflows}</span>
                        )}
                      </td>
                      <td role="cell" data-label={d.project.openAlerts}>
                        {sharedControls(c) ? (
                          <span class="sub">{d.project.sharedRepo}</span>
                        ) : (
                          <span class="cell">
                            {alerts.text ?? <span class="muted">{d.common.unknown}</span>}
                            {alerts.partial && alerts.text !== null && (
                              <span class="sub"> · {d.project.alertsPartial}</span>
                            )}
                          </span>
                        )}
                      </td>
                      <td role="cell" data-label={d.project.coverageCol}>
                        {!hasRequired(c) ? (
                          <span class="muted">{d.project.noRequired}</span>
                        ) : gaps.length === 0 ? (
                          <ControlSymbol
                            state="enabled"
                            required
                            locale={locale}
                            label={d.project.allRequiredEnabled}
                          />
                        ) : (
                          <span class="comps__gaps">
                            {gaps.map((x) => (
                              <ControlSymbol
                                state={x.state}
                                required={x.required}
                                locale={locale}
                                label={d.control[x.control]}
                              />
                            ))}
                          </span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
        {sharedAlertsComponent && sharedAlerts && (
          <p class="note" data-shared-alerts>
            {d.project.sharedAlerts} <code>{sharedAlertsComponent.repository.name}</code>:{' '}
            {sharedAlerts.text ?? d.common.unknown}
            {sharedAlerts.partial && sharedAlerts.text !== null && ` · ${d.project.alertsPartial}`}
          </p>
        )}
      </section>

      <div class="block sections">
        <details id="workflows" class="fold disclosure">
          <summary>
            <span class="fold__title">{d.project.workflows}</span>
            <span class="fold__hint">{wfHint || d.common.none}</span>
          </summary>
          <div class="fold__body">
            <div class="table-wrap">
              <table role="table" class="table">
                <caption class="visually-hidden">{d.project.workflows}</caption>
                <thead role="rowgroup">
                  <tr role="row">
                    <th role="columnheader" scope="col">
                      {d.common.status}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.project.workflowCol}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.common.component}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.common.updated}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.workflowsPage.lastError}
                    </th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {workflows.map((w) => {
                    const v = wfView(w);
                    return (
                      <tr role="row">
                        <td role="cell" data-label={d.common.status}>
                          <span class="status-col">
                            <Pill tone={v.tone} label={v.label} />
                          </span>
                        </td>
                        <th role="rowheader" scope="row">
                          {w.name} <code class="sub">{w.file}</code>
                          {w.critical && <span class="tag">{d.workflowsPage.critical}</span>}
                        </th>
                        <td role="cell" data-label={d.common.component}>
                          <span class="cell">
                            {nameOf(w.componentId)}
                            <code class="sub comps__repo">{w.repository}</code>
                          </span>
                        </td>
                        <td role="cell" data-label={d.common.updated}>
                          {w.lastCompletedRun ? (
                            <span class="cell">
                              <RelTime iso={w.lastCompletedRun.updatedAt} i18n={i18n} />{' '}
                              <ExtLink
                                href={w.lastCompletedRun.url}
                                i18n={i18n}
                                label={f(d.common.run, { n: w.lastCompletedRun.runNumber })}
                              />
                            </span>
                          ) : (
                            <UnknownValue i18n={i18n} />
                          )}
                        </td>
                        <td role="cell" data-label={d.workflowsPage.lastError}>
                          {w.lastError ? <span>{w.lastError}</span> : <UnknownValue i18n={i18n} />}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </details>

        <details id="security" class="fold disclosure">
          <summary>
            <span class="fold__title">{d.project.securityTitle}</span>
            <span class="fold__hint">{d.project.securityHint}</span>
          </summary>
          <div class="fold__body">
            {!countsKnown && <p class="muted">{d.project.alertsUnknown}</p>}
            <RiskPanel s={s} i18n={i18n}>
              {listed.length === 0 ? (
                countsKnown && <p class="muted">{d.project.noCriticalHigh}</p>
              ) : (
                <ul class="alerts" aria-label={d.project.criticalHighCaption}>
                  {listed.map((x) => (
                    <li
                      class="alerts__item"
                      data-finding-id={x.id}
                      data-sla-state={x.sla?.state ?? 'none'}
                    >
                      <span class="status-col">
                        <Pill tone={severityTone(x.severity)} label={d.severity[x.severity]} />
                      </span>
                      <span class="alerts__text">
                        <span>
                          {x.title && !x.repositoryPrivate ? x.title : d.common.privateWithheld}
                        </span>
                        <span class="sub">
                          {d.findingSource[x.source]} · <code>{x.repository}</code>
                        </span>
                        <span class="alerts__risk">
                          <SlaMeta finding={x} i18n={i18n} now={s.generatedAt} />
                        </span>
                      </span>
                      <ExtLink href={x.htmlUrl} i18n={i18n} label={d.project.openInGitHub} />
                    </li>
                  ))}
                </ul>
              )}
            </RiskPanel>
            {countsKnown && unlisted.length > 0 && (
              <p class="alerts__unlisted" data-unlisted-crit-high>
                {f(d.project.unlistedCritHigh, { alerts: unlistedText })}
              </p>
            )}
            {countsKnown && otherAlerts > 0 && (
              <p>
                {f(
                  otherAlerts === 1
                    ? d.project.otherAlertsOnGitHubOne
                    : d.project.otherAlertsOnGitHub,
                  { n: otherAlerts },
                )}
              </p>
            )}
            {countsKnown && !s.securityHealth.countsComplete && (
              <p class="note">{d.common.partial}</p>
            )}
            <ul class="ghlinks">
              {repos.map((r) => (
                <li>
                  <ExtLink href={`${r.url}/security`} i18n={i18n}>
                    {d.project.openInGitHub}: <code>{r.name}</code>
                  </ExtLink>
                </li>
              ))}
            </ul>
            <p>
              <a href={`${href(locale, 'security')}#${s.project.id}`}>{d.nav.security} →</a>
            </p>
          </div>
        </details>

        <details id="coverage" class="fold disclosure">
          <summary>
            <span class="fold__title">{d.project.coveragePerControl}</span>
            <span class="fold__hint">
              {s.securityCoverage.required > 0
                ? coverageLine(d.project.coverageHint)
                : d.project.noRequired}
            </span>
          </summary>
          <div class="fold__body">
            <ul class="ctrls">
              {s.securityCoverage.perControl.map((x) => (
                <li class="ctrls__item">
                  <ControlSymbol
                    state={x.state}
                    required={x.required}
                    locale={locale}
                    label={d.control[x.control]}
                  />
                  <span class="sub">
                    {x.required ? d.securityPage.required : d.securityPage.optional} ·{' '}
                    {d.controlState[x.state]}
                  </span>
                </li>
              ))}
            </ul>
            <p class="note">
              {d.securityPage.coverageNote}{' '}
              <RelTime iso={s.securityCoverage.collectedAt} i18n={i18n} />
            </p>
          </div>
        </details>

        <details id="repository-controls" class="fold disclosure">
          <summary>
            <span class="fold__title">{d.project.repoControls.title}</span>
            <span class="fold__hint">
              {s.repositoryControls.enabled
                ? f(d.project.repoControls.summary, {
                    passed: i18n.number(s.repositoryControls.passed),
                    applicable: i18n.number(
                      s.repositoryControls.passed + s.repositoryControls.failed,
                    ),
                    unknown: i18n.number(s.repositoryControls.unknown),
                  })
                : d.project.repoControls.off}
            </span>
          </summary>
          <div class="fold__body">
            <RepositoryControlsSection s={s} i18n={i18n} />
          </div>
        </details>

        <QualitySection s={s} i18n={i18n} thresholds={qualityPolicy} />

        <details id="errors" class="fold disclosure">
          <summary>
            <span class="fold__title">{d.project.errors}</span>
            <span class="fold__hint">
              {s.collectionErrors.length === 0
                ? d.common.noErrors
                : `${s.collectionErrors.length} · ${errorClasses.join(', ')}`}
            </span>
          </summary>
          <div class="fold__body">
            <ErrorsTable errors={s.collectionErrors} i18n={i18n} caption={d.project.errors} />
            {s.dataFreshness.staleSources.length > 0 && (
              <>
                <h3>{d.project.staleSources}</h3>
                <ul class="stale">
                  {s.dataFreshness.staleSources.map((x) => (
                    <li>
                      <code>{x.repository}</code> · {d.errorSource[x.source]} ·{' '}
                      <RelTime iso={x.lastUpdatedAt} i18n={i18n} />
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </details>
      </div>

      <div class="plegend">
        <Legend i18n={i18n} />
      </div>
    </>
  )}
</Base>

<script>
  import '../../../scripts/project-details';
</script>

