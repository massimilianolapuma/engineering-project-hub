---
import {
  CONTROL_IDS,
  countsAsOpen,
  type CollectionError,
  type ControlId,
  type ControlState,
  type ProjectSnapshot,
} from '@model/index';
import ControlSymbol from '../../components/ControlSymbol.astro';
import ErrorState from '../../components/ErrorState.astro';
import ExtLink from '../../components/ExtLink.astro';
import Legend from '../../components/Legend.astro';
import Pill from '../../components/Pill.astro';
import RelTime from '../../components/RelTime.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StatusDot from '../../components/StatusDot.astro';
import RiskPill from '../../components/RiskPill.astro';
import UnknownValue from '../../components/UnknownValue.astro';
import Base from '../../layouts/Base.astro';
import { pageContext } from '../../lib/page';
import { exportHref, href, localeParams } from '../../lib/routes';
import { scoreSortKey } from '../../lib/score';
import { severityTone } from '../../lib/tones';

export const getStaticPaths = localeParams;
const { locale } = Astro.props;
const { i18n, data, index, alternates } = pageContext(locale, 'security');
const { d, f } = i18n;
const t = d.securityPage;

/** Same order as the portfolio: worst score first, insufficient data right after red. */
const projects: ProjectSnapshot[] = (data.ok ? data.data.projects : [])
  .slice()
  .sort(
    (a, b) =>
      scoreSortKey(a.score) - scoreSortKey(b.score) || a.project.name.localeCompare(b.project.name),
  );

const SEVERITY_KEYS = ['critical', 'high', 'medium', 'low'] as const;
type SeverityKey = (typeof SEVERITY_KEYS)[number];
/** Portfolio total; null (unknown, never 0) when no project could be read for it. */
const total = (k: SeverityKey) => {
  const vals = projects.map((p) => p.securityHealth.openCounts[k]);
  return vals.every((v) => v === null) ? null : vals.reduce<number>((a, v) => a + (v ?? 0), 0);
};
const totals = SEVERITY_KEYS.map((k) => [k, total(k)] as const);
const incomplete = projects.filter((p) => !p.securityHealth.countsComplete);
/** Some project could not be fully read: every known total is a lower bound ("≥ n"). */
const lowerBound = incomplete.length > 0;

const BLIND: readonly ControlState[] = ['not-authorised', 'unknown', 'collection-failed'];
const isBlind = (s: ControlState) => BLIND.includes(s);
const requiredControls = (p: ProjectSnapshot) =>
  p.securityCoverage.perControl.filter((c) => c.required);
const blindCount = projects.reduce(
  (n, p) => n + requiredControls(p).filter((c) => isBlind(c.state)).length,
  0,
);
const criticalTotal = total('critical');
const plural = (n: number, one: string, other: string) => f(n === 1 ? one : other, { n });
const lead = f(t.lead, {
  critical:
    criticalTotal === null
      ? t.leadCriticalUnknown
      : f(criticalTotal === 1 ? t.leadCriticalOne : t.leadCriticalOther, {
          // Incomplete counts are a lower bound, as in the totals below.
          n: lowerBound ? `${t.atLeast} ${criticalTotal}` : criticalTotal,
        }),
  blind: blindCount === 0 ? t.leadBlindNone : plural(blindCount, t.leadBlindOne, t.leadBlindOther),
});

/** Collection error source that feeds each control (for the HTTP status of a blind spot). */
const SOURCE: Partial<Record<ControlId, CollectionError['source']>> = {
  codeScanning: 'code-scanning',
  secretScanning: 'secret-scanning',
  dependabot: 'dependabot',
};
const httpStatusFor = (p: ProjectSnapshot, control: ControlId) => {
  const source = SOURCE[control] ?? 'security-status-file';
  return (
    p.collectionErrors.find((e) => e.source === source && e.httpStatus !== null)?.httpStatus ?? null
  );
};
/** Oldest last scan of a stale control across the project's repositories. */
const staleScanAt = (p: ProjectSnapshot, control: ControlId) =>
  p.securityControls
    .flatMap((rc) => rc.controls)
    .filter((c) => c.control === control && c.state === 'stale' && c.lastScanAt)
    .map((c) => c.lastScanAt as string)
    .sort()[0] ?? null;
/** Text after the control name: what is wrong with it (nothing when it is enabled). */
const controlDetail = (p: ProjectSnapshot, control: ControlId, state: ControlState) => {
  if (state === 'enabled' || state === 'stale') return null;
  if (isBlind(state)) {
    const status = httpStatusFor(p, control);
    return status === null
      ? d.controlState[state]
      : f(t.stateWithHttp, { state: d.controlState[state], status });
  }
  return state === 'not-configured' ? d.symbols.gap : d.controlState[state];
};
const allRequiredEnabled = (p: ProjectSnapshot) =>
  requiredControls(p).every((c) => c.state === 'enabled');
/** Counted critical alerts: one accepted by an exception is listed in the queue, not here. */
const criticalFindings = (p: ProjectSnapshot) =>
  p.securityFindings.filter((x) => countsAsOpen(x) && x.severity === 'critical');

/** Portfolio total of a risk figure; null (unknown, never 0) when no project measured it. */
const riskTotal = (pick: (p: ProjectSnapshot) => number | null) => {
  const vals = projects.map(pick);
  return vals.every((v) => v === null) ? null : vals.reduce<number>((a, v) => a + (v ?? 0), 0);
};
const sumKnown = (values: (number | null)[]) =>
  values.every((v) => v === null) ? null : values.reduce<number>((a, v) => a + (v ?? 0), 0);
const riskTotals = [
  [
    'overdue',
    d.risk.totalOverdue,
    riskTotal((p) => sumKnown(Object.values(p.securityHealth.remediation.overdue))),
  ],
  [
    'accepted',
    d.risk.totalAccepted,
    riskTotal((p) => sumKnown(Object.values(p.securityHealth.acceptedCounts))),
  ],
] as const;
const orUnknown = (n: number | null) => (n === null ? d.common.unknown : i18n.number(n));

/**
 * Remediation queue: every open critical and high alert, counted or accepted, overdue first,
 * then within SLA by due date, then accepted, then unknown age.
 */
const QUEUE_CAP = 100;
const STATE_RANK = { overdue: 0, within: 1, paused: 2, unknown: 3, none: 4 } as const;
const queueAll = projects
  .flatMap((p) =>
    p.securityFindings
      .filter((x) => x.status === 'open' && (x.severity === 'critical' || x.severity === 'high'))
      .map((x) => ({ p, x, state: x.sla?.state ?? ('none' as const) })),
  )
  .sort(
    (a, b) =>
      STATE_RANK[a.state] - STATE_RANK[b.state] ||
      (a.x.sla?.dueAt ?? '￿').localeCompare(b.x.sla?.dueAt ?? '￿') ||
      a.x.id.localeCompare(b.x.id),
  );
const queue = queueAll.slice(0, QUEUE_CAP);
const queueMore = queueAll.length - queue.length;
const stateText = (row: (typeof queueAll)[number]) =>
  row.state === 'paused' && row.x.exception
    ? f(d.risk.queueState.paused, { date: i18n.day(row.x.exception.expires) })
    : d.risk.queueState[row.state];
const queuePill = (row: (typeof queueAll)[number]) =>
  row.state === 'overdue'
    ? ('overdue' as const)
    : row.state === 'paused'
      ? ('accepted' as const)
      : null;
const days = (n: number | null | undefined) =>
  n === null || n === undefined ? d.common.unknown : f(d.risk.days, { n });
const issuesOf = (p: ProjectSnapshot) => {
  const e = p.securityHealth.exceptionStates;
  return e.expired + e.stale + e.unverifiable;
};
const githubSecurity = (p: ProjectSnapshot) =>
  p.coordinator.repository.url ? `${p.coordinator.repository.url}/security` : null;
const componentName = (p: ProjectSnapshot, cid: string) =>
  cid === 'coordinator'
    ? d.common.coordinator
    : (p.components.find((c) => c.id === cid)?.name ?? cid);
---

<Base i18n={i18n} title={t.title} page="security" alternates={alternates} index={index}>
  {!data.ok && <ErrorState error={data.error} i18n={i18n} />}
  {data.ok && (
    <div class="sec">
      <header class="sec-head">
        <h1>{t.title}</h1>
        <p class="sec-lead">{lead}</p>
        <p class="muted sec-summary">{t.summary}</p>
        <p class="page-export">
          <a class="btn btn--ghost" href={exportHref('findings-summary.csv')} download>
            {d.exports.findings}
          </a>
        </p>
      </header>

      <section class="sec-totals" aria-labelledby="h-sec-totals" data-security-totals>
        <h2 id="h-sec-totals" class="visually-hidden">
          {t.totals}
        </h2>
        <ul class="sec-totals__grid">
          {totals.map(([k, n]) => (
            <li class="card sec-total">
              <span
                class:list={[
                  'sec-total__num',
                  { 'sec-total__num--critical': k === 'critical' && n !== null && n > 0 },
                  { 'sec-total__num--unknown': n === null },
                ]}
                data-severity={k}
              >
                {n === null ? (
                  <UnknownValue i18n={i18n} />
                ) : lowerBound ? (
                  <>
                    <span aria-hidden="true">≥</span>
                    <span class="visually-hidden">{t.atLeast} </span>
                    {i18n.number(n)}
                  </>
                ) : (
                  i18n.number(n)
                )}
              </span>
              <span class="muted">{d.severity[k]}</span>
            </li>
          ))}
          {riskTotals.map(([key, label, n]) => (
            <li class="card sec-total" data-total={key} data-value={n ?? ''}>
              <span class:list={['sec-total__num', { 'sec-total__num--unknown': n === null }]}>
                {n === null ? (
                  <UnknownValue i18n={i18n} />
                ) : lowerBound ? (
                  <>
                    <span aria-hidden="true">≥</span>
                    <span class="visually-hidden">{t.atLeast} </span>
                    {i18n.number(n)}
                  </>
                ) : (
                  i18n.number(n)
                )}
              </span>
              <span class="muted">{label}</span>
            </li>
          ))}
        </ul>
        {incomplete.length > 0 && (
          <p class="note sec-note">
            {f(t.incompleteCounts, { projects: incomplete.map((p) => p.project.name).join(', ') })}{' '}
            <a href={href(locale, 'dataQuality')}>{t.why}</a>
          </p>
        )}
      </section>

      <section class="sec-projects" aria-labelledby="h-sec-projects">
        <h2 id="h-sec-projects" class="visually-hidden">
          {t.projects}
        </h2>
        {projects.map((p) => {
          const h = p.securityHealth;
          const cov = p.securityCoverage;
          const grey = h.status === 'grey';
          const projectHref = href(locale, `projects/${p.project.id}`);
          const statusLabel = `${d.dimensions.security}: ${i18n.status(h.status)}`;
          return (
            <article
              class:list={['card', 'sec-card', { 'card--unknown': grey }]}
              id={p.project.id}
              data-project={p.project.id}
              data-health={h.status}
              aria-labelledby={`h-${p.project.id}`}
            >
              <div class="sec-card__head">
                <StatusDot status={h.status} label={statusLabel} />
                <h3 id={`h-${p.project.id}`} class="sec-card__title">
                  <a href={projectHref}>{p.project.name}</a>
                </h3>
                <StatusBadge
                  status={h.status}
                  i18n={i18n}
                  context={d.dimensions.security}
                  size="sm"
                />
                {!grey && (
                  <span class="muted sec-card__coverage">
                    {f(t.coverageOf, { available: cov.available, required: cov.required })}
                  </span>
                )}
              </div>

              {grey ? (
                <>
                  <p class="sec-card__nodata">
                    {p.collectionErrors.length === 0
                      ? t.noDataNoErrors
                      : plural(p.collectionErrors.length, t.noDataOne, t.noDataOther)}{' '}
                    <strong>{t.notZero}</strong>
                  </p>
                  <div class="sec-card__links">
                    <a href={href(locale, 'dataQuality')}>{t.seeDataQuality}</a>
                  </div>
                </>
              ) : (
                <>
                  <ul class="sec-sev" aria-label={t.severityCounts}>
                    {SEVERITY_KEYS.map((k) => {
                      const n = h.openCounts[k];
                      return (
                        <li>
                          <b
                            class:list={[
                              'sec-sev__num',
                              { 'sec-sev__num--critical': k === 'critical' && n !== null && n > 0 },
                            ]}
                            data-count={k}
                          >
                            {n === null ? <UnknownValue i18n={i18n} /> : i18n.number(n)}
                          </b>{' '}
                          {d.severity[k]}
                        </li>
                      );
                    })}
                    {requiredControls(p)
                      .filter((c) => isBlind(c.state))
                      .map((c) => (
                        <li>
                          <Pill
                            tone="grey"
                            label={f(t.alertsNotVisible, { control: d.control[c.control] })}
                          />
                        </li>
                      ))}
                  </ul>

                  <p class="sec-risk" data-risk-line>
                    <a href={`${projectHref}#exceptions`}>
                      {f(d.risk.securityCardLine, {
                        overdue: orUnknown(sumKnown(Object.values(h.remediation.overdue))),
                        accepted: orUnknown(sumKnown(Object.values(h.acceptedCounts))),
                        issues: issuesOf(p),
                      })}
                    </a>
                  </p>

                  {criticalFindings(p).length > 0 && (
                    <div class="sec-crit">
                      <h4 class="sec-crit__title">{t.criticalAlerts}</h4>
                      <ul class="sec-crit__list">
                        {criticalFindings(p).map((x) => (
                          <li>
                            <span class="status-col">
                              <Pill tone={severityTone('critical')} label={d.severity.critical} />
                            </span>
                            <span class="sec-crit__text">
                              {x.title ?? <span class="muted">{d.common.privateWithheld}</span>}{' '}
                              <code class="sec-crit__repo">{x.repository}</code>
                            </span>
                            <ExtLink href={x.htmlUrl} i18n={i18n} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {!allRequiredEnabled(p) && (
                    <ul class="sec-ctl" aria-label={t.requiredControls}>
                      {requiredControls(p).map((c) => {
                        const detail = controlDetail(p, c.control, c.state);
                        const scanAt = c.state === 'stale' ? staleScanAt(p, c.control) : null;
                        return (
                          <li>
                            <ControlSymbol
                              state={c.state}
                              required={c.required}
                              locale={locale}
                              label={
                                detail
                                  ? `${d.control[c.control]} · ${detail}`
                                  : d.control[c.control]
                              }
                            />
                            {c.state === 'stale' && (
                              <span class="sec-ctl__scan">
                                · {t.lastScan} <RelTime iso={scanAt} i18n={i18n} />
                              </span>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  )}

                  <div class="sec-card__links">
                    <a href={projectHref}>{t.projectDetail}</a>
                    {githubSecurity(p) && (
                      <ExtLink href={githubSecurity(p)} i18n={i18n} label={t.openInGitHub} />
                    )}
                  </div>
                </>
              )}
            </article>
          );
        })}
      </section>

      <details class="sec-queue disclosure" open>
        <summary>
          <span class="sec-queue__title">{d.risk.queueTitle}</span>
          <span class="sec-queue__hint">{f(d.risk.queueHint, { n: queueAll.length })}</span>
        </summary>
        <div class="sec-queue__body">
          {queue.length === 0 ? (
            <p class="muted">{d.risk.queueEmpty}</p>
          ) : (
            <div class="table-wrap">
              <table role="table" class="table table--queue">
                <caption class="visually-hidden">{d.risk.queueTitle}</caption>
                <thead role="rowgroup">
                  <tr role="row">
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.severity}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.alert}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.project}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.age}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.sla}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.due}
                    </th>
                    <th role="columnheader" scope="col">
                      {d.risk.queueCol.state}
                    </th>
                  </tr>
                </thead>
                <tbody role="rowgroup">
                  {queue.map((row) => {
                    const { p, x } = row;
                    const pill = queuePill(row);
                    return (
                      <tr role="row" data-finding-id={x.id} data-sla-state={row.state}>
                        <td role="cell" data-label={d.risk.queueCol.severity}>
                          <Pill tone={severityTone(x.severity)} label={d.severity[x.severity]} />
                        </td>
                        <td role="cell" data-label={d.risk.queueCol.alert}>
                          <span class="cell">
                            {x.title && !x.repositoryPrivate ? (
                              x.title
                            ) : (
                              <span class="muted">{d.common.privateWithheld}</span>
                            )}
                            <code class="sub">{x.repository}</code>
                            <ExtLink href={x.htmlUrl} i18n={i18n} />
                          </span>
                        </td>
                        <td role="cell" data-label={d.risk.queueCol.project}>
                          <a href={href(locale, `projects/${p.project.id}`)}>{p.project.name}</a>
                        </td>
                        <td role="cell" class="num" data-label={d.risk.queueCol.age}>
                          {days(x.sla?.ageDays)}
                        </td>
                        <td role="cell" class="num" data-label={d.risk.queueCol.sla}>
                          {x.sla?.days ? days(x.sla.days) : d.common.none}
                        </td>
                        <td role="cell" data-label={d.risk.queueCol.due}>
                          {x.sla?.dueAt ? i18n.day(x.sla.dueAt) : d.common.unknown}
                        </td>
                        <td role="cell" data-label={d.risk.queueCol.state}>
                          <span class="cell">
                            {pill && <RiskPill kind={pill} i18n={i18n} />}
                            <span class={pill ? 'sub' : undefined}>{stateText(row)}</span>
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
          {queueMore > 0 && <p class="note">{f(d.risk.queueMore, { n: queueMore })}</p>}
        </div>
      </details>

      <details class="sec-matrix disclosure">
        <summary>{t.coverageMatrix}</summary>
        <div class="sec-matrix__body">
          <p class="note">{t.coverageNote}</p>
          {projects.map((p) => (
            <div class="sec-matrix__project">
              <h3 class="h3">
                <a href={href(locale, `projects/${p.project.id}`)}>{p.project.name}</a>
              </h3>
              <div class="table-wrap">
                <table role="table" class="table table--matrix table--coverage">
                  <caption class="visually-hidden">
                    {t.coverageMatrix} · {p.project.name}
                  </caption>
                  <thead role="rowgroup">
                    <tr role="row">
                      <th role="columnheader" scope="col">
                        {d.common.repository}
                      </th>
                      {CONTROL_IDS.map((c) => {
                        const req = p.securityCoverage.perControl.find(
                          (x) => x.control === c,
                        )?.required;
                        return (
                          <th role="columnheader" scope="col">
                            {d.control[c]}
                            <span class="sub">{req ? t.required : t.optional}</span>
                          </th>
                        );
                      })}
                    </tr>
                  </thead>
                  <tbody role="rowgroup">
                    {p.securityControls.map((rc) => (
                      <tr role="row">
                        <th role="rowheader" scope="row">
                          <code>{rc.repository}</code>
                          <span class="sub">{componentName(p, rc.componentId)}</span>
                        </th>
                        {CONTROL_IDS.map((c) => {
                          const x = rc.controls.find((y) => y.control === c);
                          return (
                            <td role="cell" data-label={d.control[c]}>
                              {x ? (
                                <ControlSymbol
                                  state={x.state}
                                  required={x.required}
                                  locale={locale}
                                />
                              ) : (
                                <UnknownValue i18n={i18n} class="muted" />
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </div>
      </details>

      <Legend i18n={i18n} kind="symbols" />
    </div>
  )}
</Base>

<style>
  .sec {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .sec-head h1 {
    margin: 0;
  }
  .sec-lead {
    margin: 6px 0 0;
    font-size: var(--fs-lead);
    line-height: 24px;
    font-weight: 600;
  }
  .sec-summary {
    margin: var(--space-1) 0 0;
  }
  .sec-totals {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .sec-totals__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sec-total {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: var(--space-4);
  }
  .sec-total__num {
    font-size: var(--fs-score);
    line-height: 34px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .sec-total__num--critical {
    color: var(--red-text);
  }
  .sec-total__num--unknown {
    color: var(--text-muted);
  }
  .sec-note {
    margin: 0;
  }
  .sec-projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .sec-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
  }
  .card--unknown {
    border-style: dashed;
    border-color: var(--unknown);
    gap: var(--space-2);
  }
  .sec-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .sec-card__title {
    margin: 0;
    font-size: var(--fs-card);
    line-height: 22px;
    font-weight: 600;
  }
  .sec-card__title a {
    color: var(--text);
  }
  .sec-card__coverage {
    margin-left: auto;
  }
  .sec-card__nodata {
    margin: 0;
  }
  .sec-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .sec-card__links :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
  }
  .sec-sev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sec-sev__num {
    font-size: var(--fs-count);
    font-variant-numeric: tabular-nums;
  }
  .sec-sev__num--critical {
    color: var(--red-text);
  }
  .sec-crit__title {
    margin: 0 0 var(--space-1);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-muted);
  }
  .sec-crit__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sec-crit__list li {
    display: flex;
