# =============================================================================
# .gitignore
# Covers: .NET, Python, Node.js/Angular, Terraform, Kubernetes, IDE files
# =============================================================================

# -----------------------------------------------------------------------------
# OS Generated
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# -----------------------------------------------------------------------------
# .NET / C#
# -----------------------------------------------------------------------------
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Node.js / Angular / Frontend
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Angular
.angular/
dist/
tmp/
out-tsc/
*.tsbuildinfo

# TypeScript
*.tsbuildinfo

# Environment files (keep templates)
.env.local
.env.*.local
.env.development
.env.production

# -----------------------------------------------------------------------------
# Terraform
# -----------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# -----------------------------------------------------------------------------
# Kubernetes / Helm
# -----------------------------------------------------------------------------
*.decoded.yaml
*.decrypted.yaml
charts/*.tgz

# -----------------------------------------------------------------------------
# Secrets & Credentials (NEVER commit these)
# -----------------------------------------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
**/secrets/
**/.secrets/
**/credentials/
*.credentials
appsettings.*.json
!appsettings.Development.json.template
!appsettings.Production.json.template
local.settings.json

# -----------------------------------------------------------------------------
# Logs & Temp Files
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.cache

# -----------------------------------------------------------------------------
# Test Results & Coverage
# -----------------------------------------------------------------------------
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml

# -----------------------------------------------------------------------------
# Build Artifacts
# -----------------------------------------------------------------------------
artifacts/
publish/
out/

# ---------------------------------------------------------------
# Engineering Project Hub (Node / Astro)
# ---------------------------------------------------------------
# The Python "lib/" rule above would otherwise hide Astro sources.
!src/lib/
node_modules/
.astro/
dist/
coverage/
public/data/
test-results/
playwright-report/
.env.*
!.env.example
*.pem

# Local catalog for real repositories (never commit: this repository is public)
config.local/
.e2e-dist/
