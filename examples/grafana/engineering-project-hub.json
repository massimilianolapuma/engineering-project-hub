              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "green"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Green"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "grey"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Not visible"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Score",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "hub_project_score{project=~\"$project\"}",
          "legendFormat": "{{project}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "custom": {
            "spanNulls": false
