{
  "id": null,
  "uid": "engineering-project-hub",
  "title": "Engineering Project Hub",
  "description": "Portfolio health from the Engineering Project Hub metrics file (data/metrics/hub.prom). A missing series means \"not measured\", never 0.",
  "tags": ["engineering-hub"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(hub_project_status, project)",
          "refId": "project"
        },
        "definition": "label_values(hub_project_status, project)",
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Projects per status",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (status) (hub_portfolio_projects)",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "red"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Red"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "amber"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Amber"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "green"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Green"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "grey"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Not visible"
              }
            ]
          }
        ]
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Data age",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - hub_collection_timestamp_seconds",
          "legendFormat": "Data age",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 28800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Overdue critical or high alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(hub_project_overdue_alerts{class=\"critical_high\",project=~\"$project\"})",
          "legendFormat": "Overdue critical or high",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Not measured"
        },
        "overrides": []
      },
      "options": {
        "textMode": "value_and_name",
        "colorMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
